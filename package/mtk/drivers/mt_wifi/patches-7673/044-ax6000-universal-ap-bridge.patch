+		if (cpu_proxy_phase) return -EBUSY;
+		cpu_proxy_cookie = r->cookie;
+	} else if (r->cookie != cpu_proxy_cookie || r->phase != cpu_proxy_phase + 1)
+		return -EPROTO;
