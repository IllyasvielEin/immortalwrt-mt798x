+	if (atomic_read(&cpu_profile_error) || mtk_cpu_profile_is_fatal())
+		return -EIO;
+	smp_store_release(&cpu_profile_configured, false);
+	err = cpu_profile_restore_fn(cpu_profile_context);
+	if (err) {
