+void device_wireless_refresh(struct device *dev, struct device *parent)
+{
+	struct device_wireless_policy p = dev->wireless_local;
+	bool changed;
+	if (parent) {
+		p.wireless |= parent->wireless;
+		p.ap |= parent->wireless_ap;
+		p.forwarding |= parent->wireless_bridge_forwarding;
+		p.proxyarp |= parent->wireless_proxyarp;
+		p.isolate |= parent->wireless_isolate;
+		p.bridge_isolate |= parent->wireless_bridge_isolate;
+		if (!p.multicast_set && parent->wireless_multicast_set) {
+			p.multicast_set = true; p.multicast = parent->wireless_multicast;
+		}
+	}
+	changed = dev->wireless_parent != parent || dev->wireless != p.wireless ||
+		dev->wireless_ap != p.ap || dev->wireless_bridge_forwarding != p.forwarding ||
+		dev->wireless_proxyarp != p.proxyarp || dev->wireless_isolate != p.isolate ||
+		dev->wireless_bridge_isolate != p.bridge_isolate ||
+		dev->wireless_multicast_set != p.multicast_set || dev->wireless_multicast != p.multicast;
+	dev->wireless_parent = parent;
+	dev->wireless = p.wireless;
+	dev->wireless_ap = p.ap;
+	dev->wireless_bridge_forwarding = p.forwarding;
+	dev->wireless_proxyarp = p.proxyarp;
+	dev->wireless_isolate = p.isolate;
+	dev->wireless_bridge_isolate = p.bridge_isolate;
+	dev->wireless_multicast_set = p.multicast_set;
+	dev->wireless_multicast = p.multicast;
+	dev->bpdu_filter = p.ap;
+	if (changed) {
+		device_broadcast_event(dev, DEV_EVENT_WIRELESS_POLICY);
+		ap_bridge_reconcile(dev);
+	}
