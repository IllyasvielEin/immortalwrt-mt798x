+INT ap_tx_pkt_handle(RTMP_ADAPTER *pAd, struct wifi_dev *wdev, TX_BLK *tx_blk)
+{
+#ifdef CONFIG_MTK_AP_BRIDGE
+	struct mtk_ap_bridge_reader reader = { 0 };
+	PQUEUE_ENTRY q;
+	INT ret;
+	bool valid = mtk_ap_tx_enter_queued(pAd, wdev, tx_blk->pPacket, &reader);
+	if (valid)
+		valid = mtk_ap_tx_valid(pAd, wdev, tx_blk->pPacket, &reader);
+	if (!wdev || (valid && reader.gate &&
+	    (!IS_TR_WCID_VALID(pAd, RTMP_GET_PACKET_WCID(tx_blk->pPacket)) ||
+	     tx_blk->tr_entry != &pAd->tr_ctl.tr_entry[RTMP_GET_PACKET_WCID(tx_blk->pPacket)])))
+		valid = false;
+	/* Every MSDU in software/hardware aggregation is checked while DA is
+	 * still Ethernet. The reader spans construction and hardware submission.
+	 */
+	for (q = tx_blk->TxPacketList.Head; valid && q; q = q->Next)
+		valid = mtk_ap_tx_valid(pAd, wdev, QUEUE_ENTRY_TO_PACKET(q), &reader);
+	if (!valid) {
+		if (tx_blk->TxPacketList.Head) {
+			while (tx_blk->TxPacketList.Head) {
+				q = RemoveHeadQueue(&tx_blk->TxPacketList);
+				RELEASE_NDIS_PACKET(pAd, QUEUE_ENTRY_TO_PACKET(q), NDIS_STATUS_FAILURE);
+			}
+		} else {
+			RELEASE_NDIS_PACKET(pAd, tx_blk->pPacket, NDIS_STATUS_FAILURE);
+		}
+		pAd->tr_ctl.tr_cnt.tx_not_allowed_drop++;
+		mtk_ap_bridge_exit(&reader);
+		return NDIS_STATUS_FAILURE;
+	}
+	ret = ap_tx_pkt_handle_legacy(pAd, wdev, tx_blk);
+	mtk_ap_bridge_exit(&reader);
