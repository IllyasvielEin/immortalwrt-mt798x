+ */
+int mtk_ap_bridge_resolve_rcu(struct mtk_ap_bridge_gate *gate,
+			     const struct net_device *actual,
+			     const struct sk_buff *skb,
+			     struct mtk_ap_bridge_info *info);
+/* RCU held. Zero = not a domain of this gate; positive = matched and valid;
+ * negative = belongs to gate but blocked/stale. Used by driver NF hooks.
+ */
+int mtk_ap_bridge_match_rcu(struct mtk_ap_bridge_gate *gate,
+			   const struct net_device *actual,
+			   const struct sk_buff *skb,
+			   struct mtk_ap_bridge_info *info);
