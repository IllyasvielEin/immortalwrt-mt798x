+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __AP_BRIDGE_PARSE_H
+#define __AP_BRIDGE_PARSE_H
+
+/* Pure, bounded wire parser: also compiled directly by the host tests. */
+enum apbr_wire_format { APBR_ETHERNET, APBR_LLC, APBR_IEEE80211 };
+enum apbr_wire_kind { APBR_WIRE_INVALID = -1, APBR_WIRE_DATA, APBR_WIRE_EAPOL };
+struct apbr_wire_view {
+	unsigned int type_offset;
+	unsigned int eap_offset;
+	unsigned int eap_length;
+	unsigned int tags;
+};
+
+static inline unsigned int apbr_be16(const unsigned char *p)
+{
+	return ((unsigned int)p[0] << 8) | p[1];
+}
+
+static inline int apbr_is_vlan(unsigned int type)
+{
+	return type == 0x8100 || type == 0x88a8;
+}
+
+static inline int apbr_snap(const unsigned char *p, unsigned int len)
+{
+	return len >= 8 && p[0] == 0xaa && p[1] == 0xaa &&
+		p[2] == 3 && p[3] == 0 && p[4] == 0 &&
+		(p[5] == 0 || p[5] == 0xf8);
+}
+
+static inline enum apbr_wire_kind
+apbr_parse_wire(const unsigned char *p, unsigned int len,
+		enum apbr_wire_format format, struct apbr_wire_view *v)
+{
+	unsigned int off = 0, limit = len, type, body, eap_len;
+	unsigned int fc, hdr;
+	struct apbr_wire_view result = { 0, 0, 0, 0 };
+
+	if (!p || !v)
+		return APBR_WIRE_INVALID;
+	*v = result;
+	if (format == APBR_ETHERNET) {
+		if (len < 14)
+			return APBR_WIRE_INVALID;
+		off = 12;
+		/* IEEE 802.3 length + LLC/SNAP, bounded by the declared MSDU. */
+		if (apbr_be16(p + off) <= 1500) {
+			body = apbr_be16(p + off);
+			if (body > len - 14)
+				return APBR_WIRE_INVALID;
+			if (!apbr_snap(p + 14, body))
+				return APBR_WIRE_DATA;
+			limit = 14 + body;
+			off = 20;
+		}
+	} else {
+		if (format == APBR_IEEE80211) {
+			if (len < 24)
+				return APBR_WIRE_INVALID;
+			fc = p[0] | ((unsigned int)p[1] << 8);
+			if ((fc & 0x000c) != 0x0008)
+				return APBR_WIRE_INVALID;
+			hdr = 24 + (((fc & 0x0300) == 0x0300) ? 6 : 0);
+			if (fc & 0x0080) {
+				if (len < hdr + 2)
+					return APBR_WIRE_INVALID;
+				/* An A-MSDU is not one authentication frame. */
+				if (p[hdr] & 0x80)
+					return APBR_WIRE_DATA;
+				hdr += 2;
+				if (fc & 0x8000)
+					hdr += 4;
+			}
+			if (len < hdr)
+				return APBR_WIRE_INVALID;
+			off = hdr;
+		} else if (format != APBR_LLC) {
+			return APBR_WIRE_INVALID;
+		}
+		if (len - off < 8)
+			return APBR_WIRE_INVALID;
+		if (!apbr_snap(p + off, len - off))
+			return APBR_WIRE_DATA;
+		off += 6;
+	}
+	result.type_offset = off;
+	type = apbr_be16(p + off);
+	while (apbr_is_vlan(type)) {
+		if (result.tags == 8 || off > limit || limit - off < 6)
+			return APBR_WIRE_INVALID;
+		result.tags++;
+		off += 4;
+		type = apbr_be16(p + off);
+	}
+	if (type != 0x888e) {
+		*v = result;
+		return APBR_WIRE_DATA;
+	}
+	/* EtherType followed by the four-byte EAPOL header. */
+	if (off > limit || limit - off < 6)
+		return APBR_WIRE_INVALID;
+	off += 2;
+	body = apbr_be16(p + off + 2);
+	if (p[off] < 1 || p[off] > 3 || p[off + 1] > 4 ||
+	    body > limit - off - 4)
+		return APBR_WIRE_INVALID;
+	switch (p[off + 1]) {
+	case 0: /* EAP: its own length is part of the authentication boundary. */
+		if (body < 4)
+			return APBR_WIRE_INVALID;
+		eap_len = apbr_be16(p + off + 6);
+		if (eap_len != body || p[off + 4] < 1 || p[off + 4] > 4 ||
+		    ((p[off + 4] == 1 || p[off + 4] == 2) && body < 5) ||
+		    ((p[off + 4] == 3 || p[off + 4] == 4) && body != 4))
+			return APBR_WIRE_INVALID;
+		break;
+	case 1: /* Start */
+	case 2: /* Logoff */
+		if (body)
+			return APBR_WIRE_INVALID;
+		break;
+	case 3: /* Key descriptor validation remains the WPA state machine's job. */
+	case 4:
+		if (!body)
+			return APBR_WIRE_INVALID;
+		break;
+	}
+	result.eap_offset = off;
+	result.eap_length = body + 4;
+	*v = result;
+	return APBR_WIRE_EAPOL;
+}
+
+/* The final queue boundary uses current objects and the still-intact DA.
+ * Pointer values identify the selected wdev; none are retained by this helper.
+ */
+static inline int apbr_tx_binding_matches(const unsigned char *da,
+		const unsigned char *peer_addr, const void *selected_wdev,
+		const void *peer_wdev, const void *tr_wdev,
+		unsigned int wcid, unsigned int bmc_wcid,
+		int sta_rec_valid, int associated, int ordinary_client,
+		int port_secured, int bmc_secured, int authentication,
+		int radius_allowed)
+{
+	unsigned int i;
+	if (!da || !peer_addr || !selected_wdev ||
+	    selected_wdev != peer_wdev || selected_wdev != tr_wdev ||
+	    !sta_rec_valid)
+		return 0;
+	if (da[0] & 1)
+		return wcid == bmc_wcid && bmc_secured;
+	if (!associated || !ordinary_client || !radius_allowed)
+		return 0;
+	for (i = 0; i < 6; i++)
+		if (da[i] != peer_addr[i])
+			return 0;
+	return port_secured || authentication;
+}
+
+static inline int apbr_isolation_denies(int in, int out, int same_bss,
+				       int no_forwarding, int no_between_bss)
+{
+	if (in < 0 || out < 0)
+		return 1;
+	if (!in || !out)
+		return 0;
+	return same_bss ? !!no_forwarding : !!no_between_bss;
+}
+
+#endif
