 EXPORT_SYMBOL_GPL(br_port_flag_is_set);
+
+#ifdef CONFIG_MTK_AP_BRIDGE
+/* All pointer traversal stays in bridge code; proprietary AP modules receive
+ * only values/errno, never private net_bridge_port pointers. */
+static bool br_mtk_ap_vid(const u8 *map, u16 vid)
+{
+	return map[vid >> 3] & BIT(vid & 7);
+}
+
+static bool br_mtk_ap_vlans(const struct net_bridge_vlan_group *vg,
+			    const u8 *members, const u8 *untagged, u16 pvid)
+{
+	struct net_bridge_vlan *v;
+	unsigned int count = 0, expected_count = 0, i;
+
+	if (br_get_pvid(vg) != pvid)
+		return false;
+	for (i = 0; i < MTK_AP_BRIDGE_VLAN_BYTES; i++)
+		expected_count += hweight8(members[i]);
+	if (!vg)
+		return !expected_count;
+	list_for_each_entry(v, &vg->vlan_list, vlist) {
+		if (!br_vlan_should_use(v))
+			continue;
+		if (!br_mtk_ap_vid(members, v->vid) ||
+		    br_mtk_ap_vid(untagged, v->vid) !=
+		    !!(v->flags & BRIDGE_VLAN_INFO_UNTAGGED))
+			return false;
+		count++;
+	}
+	return count == expected_count;
+}
+
+int br_mtk_ap_check_rtnl(const struct net_device *port,
+			 const struct net_device *bridge,
+			 const struct mtk_ap_bridge_domain *e)
+{
+	struct net_bridge_port *p;
+
+	ASSERT_RTNL();
+	p = br_port_get_rtnl(port);
+	if (!p || p->br->dev != bridge ||
+	    (p->flags & MTK_AP_BRIDGE_PORT_FLAGS) != e->port_flags)
+		return -EAGAIN;
+#ifdef CONFIG_BRIDGE_VLAN_FILTERING
+	if (br_opt_get(p->br, BROPT_VLAN_ENABLED) != !!e->vlan_filtering ||
+	    ntohs(p->br->vlan_proto) != e->bridge_vlan_proto ||
+	    !br_mtk_ap_vlans(nbp_vlan_group(p), e->vlans,
+			     e->untagged, e->pvid) ||
+	    !br_mtk_ap_vlans(br_vlan_group(p->br), e->bridge_vlans,
+			     e->bridge_untagged, e->bridge_pvid))
+		return -EAGAIN;
+#else
+	if (e->vlan_filtering || e->pvid || e->bridge_pvid)
+		return -EOPNOTSUPP;
+#endif
+	return 0;
+}
+EXPORT_SYMBOL(br_mtk_ap_check_rtnl);
+
+static bool br_mtk_ap_one_vid(struct net_bridge_vlan_group *vg,
+			      const u8 *members, const u8 *untagged, u16 vid)
+{
+	struct net_bridge_vlan *v = vg ? br_vlan_find(vg, vid) : NULL;
+	bool present = v && br_vlan_should_use(v);
+
+	return present == br_mtk_ap_vid(members, vid) &&
+	       (!present || !!(v->flags & BRIDGE_VLAN_INFO_UNTAGGED) ==
+			    br_mtk_ap_vid(untagged, vid));
+}
+
+bool br_mtk_ap_check_rcu(const struct net_device *port,
+			const struct net_device *bridge,
+			const struct mtk_ap_bridge_domain *e, u16 vid)
+{
+	struct net_bridge_port *p = br_port_get_check_rcu(port);
+
+	RCU_LOCKDEP_WARN(!rcu_read_lock_held(), "AP bridge check without RCU");
+	if (!p || p->br->dev != bridge ||
+	    (READ_ONCE(p->flags) & MTK_AP_BRIDGE_PORT_FLAGS) != e->port_flags)
+		return false;
+#ifdef CONFIG_BRIDGE_VLAN_FILTERING
+	if (br_opt_get(p->br, BROPT_VLAN_ENABLED) != !!e->vlan_filtering ||
+	    ntohs(READ_ONCE(p->br->vlan_proto)) != e->bridge_vlan_proto)
+		return false;
+	if (e->vlan_filtering) {
+		struct net_bridge_vlan_group *vg = nbp_vlan_group_rcu(p);
+
+		if (br_get_pvid(vg) != e->pvid)
+			return false;
+		if (!vid)
+			vid = e->pvid;
+		if (!vid || !br_mtk_ap_vid(e->vlans, vid) ||
+		    !br_mtk_ap_one_vid(vg, e->vlans, e->untagged, vid) ||
+		    !br_mtk_ap_one_vid(br_vlan_group_rcu(p->br), e->bridge_vlans,
+				   e->bridge_untagged, vid))
+			return false;
+	}
+#endif
+	return true;
+}
+EXPORT_SYMBOL(br_mtk_ap_check_rcu);
+#endif
