+	unsigned int i;
+
+	if (!warp || !warp->wed.base_addr || !warp->wdma.base_addr ||
+	    !warp->wifi.base_addr || !warp->wifi.hw.int_mask)
+		return -ENODEV;
+	wifi = &warp->wifi;
+	checked_write(warp, false, WED_INT_MSK, 0);
+	if (checked_read(warp, false, WED_INT_MSK))
+		return -EIO;
+	checked_write(warp, false, WED_WPDMA_INT_MSK, 0);
+	if (checked_read(warp, false, WED_WPDMA_INT_MSK))
+		return -EIO;
+	warp_io_write32(wifi, wifi->hw.int_mask, 0);
+	warp_io_read32(wifi, wifi->hw.int_mask, &value);
+	if (value)
+		return -EIO;
+	for (i = 0; i < ARRAY_SIZE(trigger_reg); i++) {
+		value = checked_read(warp, false, trigger_reg[i]);
+		checked_write(warp, false, trigger_reg[i], value & ~trigger_enable[i]);
+		if (checked_read(warp, false, trigger_reg[i]) & trigger_enable[i])
+			return -EIO;
+	}
+	checked_write(warp, false, WED_WDMA_INT_TRIG, 0);
+	if (checked_read(warp, false, WED_WDMA_INT_TRIG))
+		return -EIO;
+	checked_write(warp, true, WDMA_INT_MASK, 0);
+	if (checked_read(warp, true, WDMA_INT_MASK))
+		return -EIO;
+	checked_write(warp, true, WDMA_INT_GRP2, 0);
+	if (checked_read(warp, true, WDMA_INT_GRP2))
+		return -EIO;
+	value = checked_read(warp, false, WED_CTRL) & ~agents;
+	if (enable)
+		value |= BIT(WED_CTRL_FLD_WPDMA_INT_AGT_EN);
+	checked_write(warp, false, WED_CTRL, value);
+	if ((checked_read(warp, false, WED_CTRL) & agents) !=
+	    (enable ? BIT(WED_CTRL_FLD_WPDMA_INT_AGT_EN) : 0))
+		return -EIO;
+	checked_write(warp, false, WED_INT_MSK, mask);
+	if (checked_read(warp, false, WED_INT_MSK) != mask)
+		return -EIO;
+	checked_write(warp, false, WED_WPDMA_INT_MSK, mask);
+	if (checked_read(warp, false, WED_WPDMA_INT_MSK) != mask)
+		return -EIO;
+	warp_io_write32(wifi, wifi->hw.int_mask, mask);
+	warp_io_read32(wifi, wifi->hw.int_mask, &value);
+	return value == mask ? 0 : -EIO;
+}
+
+static int checked_poll(struct warp_entry *warp, bool wdma, u32 reg,
+			u32 mask, u32 expected,
+			struct mtk_warp_ser_request *r)
+{
+	int ret;
+	for (;;) {
+		ret = warp_checked_budget(r);
+		if (ret < 0)
+			return ret;
+		if ((checked_read(warp, wdma, reg) & mask) == expected)
+			return 0;
+		usleep_range(50, 100);
+	}
+}
+
+static int checked_disable(struct warp_entry *warp, bool wdma, u32 reg,
+			   u32 enable, u32 busy,
+			   struct mtk_warp_ser_request *r)
+{
+	u32 value;
+	int ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	value = checked_read(warp, wdma, reg);
+	checked_write(warp, wdma, reg, value & ~enable);
+	/* A cleared enable and all corresponding idle bits are both required. */
+	return checked_poll(warp, wdma, reg, enable | busy, 0, r);
+}
+
+int warp_checked_hw_stop(struct warp_entry *warp,
+			 struct mtk_warp_ser_request *r)
+{
+	int first = 0, ret;
+#define STOP(_wdma, _reg, _enable, _busy) do { \
+	ret = checked_disable(warp, _wdma, _reg, _enable, _busy, r); \
+	if (ret && !first) first = ret; \
+} while (0)
+#ifdef WED_TX_SUPPORT
+	STOP(false, WED_GLO_CFG, BIT(WED_GLO_CFG_FLD_TX_DMA_EN),
+	     BIT(WED_GLO_CFG_FLD_TX_DMA_BUSY));
+#endif
+#ifdef WED_HW_TX_SUPPORT
+	STOP(true, WDMA_GLO_CFG, BIT(WDMA_GLO_CFG_FLD_RX_DMA_EN),
+	     BIT(WDMA_GLO_CFG_FLD_RX_DMA_BUSY));
+	STOP(false, WED_WDMA_GLO_CFG, BIT(WED_WDMA_GLO_CFG_FLD_RX_DRV_EN),
+	     BIT(WED_WDMA_GLO_CFG_FLD_RX_DRV_BUSY));
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WED_TX_FREE_AGT_EN),
+	     BIT(WED_CTRL_FLD_WED_TX_FREE_AGT_BUSY));
+	ret = checked_poll(warp, false, WED_TX_TKID_INTF, 0x3ff0000,
+			   0x2000000, r);
+	if (ret && !first)
+		first = ret;
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WED_TX_BM_EN),
+	     BIT(WED_CTRL_FLD_WED_TX_BM_BUSY));
+#endif
+#ifdef WED_TX_SUPPORT
+	STOP(false, WED_WPDMA_GLO_CFG, BIT(WED_WPDMA_GLO_CFG_FLD_TX_DRV_EN),
+	     BIT(WED_WPDMA_GLO_CFG_FLD_TX_DRV_BUSY));
+#endif
+#ifdef WED_RX_SUPPORT
+	STOP(false, WED_WPDMA_GLO_CFG, BIT(WED_WPDMA_GLO_CFG_FLD_RX_DRV_EN),
+	     BIT(WED_WPDMA_GLO_CFG_FLD_RX_DRV_BUSY));
+#endif
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WPDMA_INT_AGT_EN),
+	     BIT(WED_CTRL_FLD_WPDMA_INT_AGT_BUSY));
+#ifdef WED_RX_D_SUPPORT
+	STOP(false, WED_WPDMA_RX_D_GLO_CFG,
+	     BIT(WED_WPDMA_RX_D_GLO_CFG_FLD_RX_DRV_EN),
+	     BIT(WED_WPDMA_RX_D_GLO_CFG_FLD_RX_DRV_BUSY));
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WED_RX_RRO_QM_EN),
+	     BIT(WED_CTRL_FLD_WED_RX_RRO_QM_BUSY));
+	/* Route queue must drain before disabling its producer-facing side. */
+	ret = checked_poll(warp, false, WED_CTRL,
+			   BIT(WED_CTRL_FLD_WED_RX_ROUTE_QM_BUSY), 0, r);
+	if (ret && !first)
+		first = ret;
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WED_RX_ROUTE_QM_EN),
+	     BIT(WED_CTRL_FLD_WED_RX_ROUTE_QM_BUSY));
+	STOP(true, WDMA_GLO_CFG, BIT(WDMA_GLO_CFG_FLD_TX_DMA_EN),
+	     BIT(WDMA_GLO_CFG_FLD_TX_DMA_BUSY));
+	STOP(false, WED_WDMA_GLO_CFG, BIT(WED_WDMA_GLO_CFG_FLD_TX_DRV_EN), 0);
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WDMA_INT_AGT_EN),
+	     BIT(WED_CTRL_FLD_WDMA_INT_AGT_BUSY));
+	STOP(false, WED_GLO_CFG, BIT(WED_GLO_CFG_FLD_RX_DMA_EN),
+	     BIT(WED_GLO_CFG_FLD_RX_DMA_BUSY));
+	STOP(false, WED_CTRL, BIT(WED_CTRL_FLD_WED_RX_BM_EN),
+	     BIT(WED_CTRL_FLD_WED_RX_BM_BUSY));
+#endif
+#undef STOP
+	return first;
+}
+
+static int checked_pulse(struct warp_entry *warp, bool wdma, u32 reg,
+			 u32 mask, bool self_clear,
+			 struct mtk_warp_ser_request *r)
+{
+	int ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	checked_write(warp, wdma, reg, mask);
+	if (!self_clear)
+		checked_write(warp, wdma, reg, 0);
+	return checked_poll(warp, wdma, reg, mask, 0, r);
+}
+
+int warp_checked_hw_reset(struct warp_entry *warp,
+			  struct mtk_warp_ser_request *r)
+{
+	int ret;
+#define PULSE(_wdma, _reg, _mask, _self) do { \
+	ret = checked_pulse(warp, _wdma, _reg, _mask, _self, r); \
+	if (ret) return ret; \
+} while (0)
+	if (!r->stop_proven)
+		return -EPERM;
+	PULSE(false, WED_RST_IDX,
+	      BIT(WED_RST_IDX_FLD_DTX_IDX0) | BIT(WED_RST_IDX_FLD_DTX_IDX1) |
+	      BIT(WED_RST_IDX_FLD_DRX_IDX0) | BIT(WED_RST_IDX_FLD_DRX_IDX1) |
+	      BIT(WED_RST_IDX_FLD_WPDMA_DRX_IDX0) |
+	      BIT(WED_RST_IDX_FLD_WPDMA_DRX_IDX1), false);
+	PULSE(true, WDMA_RST_IDX,
+	      BIT(WDMA_RST_IDX_FLD_RST_DRX_IDX0) | BIT(WDMA_RST_IDX_FLD_RST_DRX_IDX1) |
+	      BIT(WDMA_RST_IDX_FLD_RST_DTX_IDX0) | BIT(WDMA_RST_IDX_FLD_RST_DTX_IDX1),
+	      false);
+	PULSE(false, WED_WDMA_RST_IDX,
+	      BIT(WED_WDMA_RST_IDX_FLD_CRX_IDX0) | BIT(WED_WDMA_RST_IDX_FLD_CRX_IDX1) |
+	      BIT(WED_WDMA_RST_IDX_FLD_DRV_IDX0) | BIT(WED_WDMA_RST_IDX_FLD_DRV_IDX1),
+	      false);
+	PULSE(false, WED_WPDMA_RST_IDX,
+	      BIT(WED_WPDMA_RST_IDX_FLD_CTX_IDX0) | BIT(WED_WPDMA_RST_IDX_FLD_CTX_IDX1) |
+	      BIT(WED_WPDMA_RST_IDX_FLD_CRX_IDX0) | BIT(WED_WPDMA_RST_IDX_FLD_CRX_IDX1),
+	      false);
+#ifdef WED_RX_D_SUPPORT
+	PULSE(false, WED_WPDMA_RX_D_RST_IDX,
+	      BIT(WED_WPDMA_RX_D_RST_IDX_FLD_CRX_IDX0) |
+	      BIT(WED_WPDMA_RX_D_RST_IDX_FLD_CRX_IDX1) |
+	      BIT(WED_WPDMA_RX_D_RST_IDX_FLD_DRV_IDX0) |
+	      BIT(WED_WPDMA_RX_D_RST_IDX_FLD_DRV_IDX1), false);
+	PULSE(false, WED_RROQM_RST_IDX,
+	      BIT(WED_RROQM_RST_IDX_FLD_FDBK) | BIT(WED_RROQM_RST_IDX_FLD_MIOD), false);
+#endif
+	PULSE(false, WED_MOD_RST,
+	      BIT(WED_MOD_RST_FLD_TX_FREE_AGT) | BIT(WED_MOD_RST_FLD_TX_BM)
+#ifdef WED_RX_D_SUPPORT
+	      | BIT(WED_MOD_RST_FLD_RX_RRO_QM) | BIT(WED_MOD_RST_FLD_RX_ROUTE_QM) |
+	      BIT(WED_MOD_RST_FLD_RX_BM)
+#endif
+	      , true);
+#undef PULSE
+	return 0;
+}
+
+static int checked_enable(struct warp_entry *warp, bool wdma, u32 reg, u32 mask)
+{
+	u32 value = checked_read(warp, wdma, reg);
+	checked_write(warp, wdma, reg, value | mask);
+	return (checked_read(warp, wdma, reg) & mask) == mask ? 0 : -EIO;
+}
+
+int warp_checked_hw_enable(struct warp_entry *warp,
+			   struct mtk_warp_ser_request *r)
+{
+	int ret;
+	u32 engines = BIT(WED_CTRL_FLD_WED_TX_BM_EN) |
+		BIT(WED_CTRL_FLD_WED_TX_FREE_AGT_EN) |
+		BIT(WED_CTRL_FLD_WPDMA_INT_AGT_EN) |
+		BIT(WED_CTRL_FLD_WDMA_INT_AGT_EN);
+#ifdef WED_RX_D_SUPPORT
+	engines |= BIT(WED_CTRL_FLD_WED_RX_BM_EN) |
+		BIT(WED_CTRL_FLD_WED_RX_RRO_QM_EN) |
+		BIT(WED_CTRL_FLD_WED_RX_ROUTE_QM_EN);
+#endif
+#define ENABLE(_wdma, _reg, _mask) do { \
+	ret = checked_enable(warp, _wdma, _reg, _mask); \
+	if (ret) return ret; \
+} while (0)
+	/* Caller holds one admitted operation and has revoked the old proof. */
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	ENABLE(false, WED_CTRL, engines);
+	warp_dma_ctrl_hw(&warp->wed, WARP_DMA_TXRX);
+	ENABLE(false, WED_GLO_CFG, BIT(WED_GLO_CFG_FLD_TX_DMA_EN) |
+		BIT(WED_GLO_CFG_FLD_RX_DMA_EN));
+	ENABLE(false, WED_WDMA_GLO_CFG, BIT(WED_WDMA_GLO_CFG_FLD_RX_DRV_EN) |
+		BIT(WED_WDMA_GLO_CFG_FLD_TX_DRV_EN));
+	ENABLE(false, WED_WPDMA_GLO_CFG, BIT(WED_WPDMA_GLO_CFG_FLD_TX_DRV_EN) |
+		BIT(WED_WPDMA_GLO_CFG_FLD_RX_DRV_EN));
+#ifdef WED_RX_D_SUPPORT
+	ENABLE(false, WED_WPDMA_RX_D_GLO_CFG,
+		BIT(WED_WPDMA_RX_D_GLO_CFG_FLD_RX_DRV_EN));
+#endif
+	ENABLE(true, WDMA_GLO_CFG, BIT(WDMA_GLO_CFG_FLD_RX_DMA_EN) |
+		BIT(WDMA_GLO_CFG_FLD_TX_DMA_EN));
+#undef ENABLE
+	return warp_checked_budget(r) < 0 ? warp_checked_budget(r) : 0;
+}
+
+#endif
