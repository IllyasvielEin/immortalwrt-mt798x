+		if (ret != 1) { ret = ret < 0 ? -errno : -EIO; close(fd); return ret; }
+		close(fd);
+		ret = read_file(path, buf, sizeof(buf));
+		if (ret < 0 || buf[0] != value[0])
+			return -EIO;
+	}
