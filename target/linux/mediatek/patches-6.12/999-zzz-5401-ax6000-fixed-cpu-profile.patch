+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_MTK_CPU_PROFILE_H
+#define _LINUX_MTK_CPU_PROFILE_H
+
+#include <linux/types.h>
+#include <linux/mtk_cpu_lifecycle.h>
+
+struct device;
+
+enum mtk_cpu_dma_fault {
+	MTK_CPU_DMA_STOP_FAILED = 1,
+	MTK_CPU_DMA_CONTROL_RACE,
+	MTK_CPU_DMA_PROOF_LOST,
+	MTK_CPU_DMA_INIT_EXPOSED,
+};
+
+/* Single, permanent MT7986 FE owner for the AX6000 CPU forwarding profile. */
+bool mtk_cpu_profile_ready(void);
+bool mtk_cpu_profile_is_fatal(void);
+void mtk_cpu_profile_note_fault(int error);
+int mtk_cpu_profile_register(struct device *owner,
+			    int (*restore)(void *context), void *context);
+int mtk_cpu_profile_restore(void);
+bool mtk_cpu_profile_restored(void);
+
+#define MTK_FE_CPU_PROFILE_ABORT 0x2010
+bool mtk_cpu_control_permitted(const void *owner, u64 cookie);
+int mtk_cpu_wifi_participant_register(const void *physical_owner);
+/* Normal open/close lifetime only: true before the first DMA exposure;
+ * false only after checked stop and complete task/IRQ/token draining. */
+int mtk_cpu_wifi_participant_set_live(const void *physical_owner, bool live);
+void mtk_cpu_wifi_participant_unregister(const void *physical_owner);
+int mtk_cpu_wifi_stop_result(const void *physical_owner, u64 cookie,
+			     int error, bool stop_proven);
+
+int mtk_cpu_fe_ser_begin(u64 *cookie);
+u64 mtk_cpu_fe_ser_cookie(void);
+int mtk_cpu_wifi_ser_begin(const void *owner, u64 join_cookie, u64 *cookie);
+void mtk_cpu_fe_ser_end(u64 cookie);
+void mtk_cpu_wifi_ser_end(const void *owner, u64 cookie);
+int mtk_cpu_ser_cleanup_begin(u64 cookie);
+void mtk_cpu_ser_cleanup_end(u64 cookie);
+
+/* Hold across the complete destructive call, not just the initial check. */
+void mtk_cpu_destruct_enter(struct mtk_cpu_lifetime *lifetime);
+void mtk_cpu_destruct_exit(struct mtk_cpu_lifetime *lifetime);
+void __noreturn mtk_cpu_dma_fatal(enum mtk_cpu_dma_fault reason, int error);
+
+#endif
