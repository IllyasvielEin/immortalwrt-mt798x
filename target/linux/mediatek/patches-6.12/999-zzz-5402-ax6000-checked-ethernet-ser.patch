+int mtk_cpu_wifi_stop_prepare(u64 cookie)
+{
+	unsigned long flags;
+	int ret;
+
+	ASSERT_RTNL();
+	reinit_completion(&cpu_stop_done);
+	spin_lock_irqsave(&cpu_profile_lock, flags);
+	if (!cookie || cookie != cpu_life.sequence || !cpu_life.fe_actor) {
+		ret = -ESTALE;
+	} else {
+		cpu_stop_owner = cpu_wifi_live ? cpu_wifi_participant : NULL;
+		cpu_stop_cookie = cookie;
+		cpu_stop_error = 0;
+		cpu_stop_ack = false;
+		cpu_stop_waiting = !!cpu_stop_owner;
+		ret = cpu_stop_waiting ? 1 : 0;
+	}
+	spin_unlock_irqrestore(&cpu_profile_lock, flags);
+	return ret;
+}
+
+int mtk_cpu_wifi_stop_result(const void *owner, u64 cookie,
+			     int error, bool proven)
+{
+	unsigned long flags;
+	bool wake = false;
+	int ret = 0;
+
+	/* Failure is sticky even outside the current FE stop-wait window. */
+	if (error || !proven) {
+		error = error < 0 ? error : -EIO;
+		mtk_cpu_profile_note_fault(error);
+	}
+	spin_lock_irqsave(&cpu_profile_lock, flags);
+	if (error || !proven) {
+		cpu_stop_error = error;
+		wake = true;
+		ret = error;
+	} else if (!cpu_stop_waiting || cpu_stop_ack || !owner ||
+		   owner != cpu_stop_owner || owner != cpu_wifi_participant ||
+		   cookie != cpu_stop_cookie || cookie != cpu_life.sequence ||
+		   cpu_life.wifi_owner != owner || !cpu_life.wifi_actor) {
+		ret = -ESTALE;
+	} else {
+		cpu_stop_ack = true;
+		wake = true;
+	}
+	spin_unlock_irqrestore(&cpu_profile_lock, flags);
+	if (wake)
+		complete(&cpu_stop_done);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_cpu_wifi_stop_result);
+
+int mtk_cpu_wifi_stop_wait(unsigned long timeout)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!wait_for_completion_timeout(&cpu_stop_done, timeout))
+		return -ETIMEDOUT;
+	spin_lock_irqsave(&cpu_profile_lock, flags);
+	ret = cpu_stop_error ?: atomic_read(&cpu_profile_error);
+	if (!ret && !cpu_stop_ack)
+		ret = -EIO;
+	cpu_stop_waiting = false;
+	spin_unlock_irqrestore(&cpu_profile_lock, flags);
+	return ret;
+}
