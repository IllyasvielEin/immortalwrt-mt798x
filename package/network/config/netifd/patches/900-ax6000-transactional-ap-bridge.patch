+static uc_value_t *
+uc_netifd_ap_action(uc_vm_t *vm, size_t nargs, bool commit)
+{
+	uc_value_t *name = uc_fn_arg(0), *res = ucv_object_new(vm);
+	struct device *dev;
+	int ret = -EINVAL;
+	if (ucv_type(name) == UC_STRING) {
+		dev = __device_get(ucv_string_get(name), 2, false);
+		if (dev) {
+			if (!commit) {
+				dev->wireless_local.forwarding = true;
+				device_wireless_refresh(dev, dev->wireless_parent);
+			}
+			ret = commit ? ap_bridge_commit(dev) : ap_bridge_prepare_new(dev);
+		}
+	}
+	ucv_object_add(res, "ok", ucv_boolean_new(!ret));
+	ucv_object_add(res, "errno", ucv_int64_new(-ret));
+	return res;
+}
+static uc_value_t *uc_netifd_ap_prepare(uc_vm_t *vm, size_t nargs)
+{
+	return uc_netifd_ap_action(vm, nargs, false);
+}
+static uc_value_t *uc_netifd_ap_commit(uc_vm_t *vm, size_t nargs)
+{
+	return uc_netifd_ap_action(vm, nargs, true);
