+	allowed = !mtk_cpu_profile_is_fatal() &&
+		((cpu_life.teardown_actor == (unsigned long)current &&
+		  cpu_life.teardown_depth) ||
+		 (owner && cookie && cpu_life.wifi_actor == (unsigned long)current &&
+		  cpu_life.wifi_owner == owner && cpu_life.sequence == cookie &&
+		  (cpu_life.cleanup & MTK_CPU_CLEANUP_WIFI)));
+	spin_unlock_irqrestore(&cpu_profile_lock, flags);
+	return allowed;
