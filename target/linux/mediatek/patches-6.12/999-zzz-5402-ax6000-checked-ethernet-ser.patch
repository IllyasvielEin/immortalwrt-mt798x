+void __noreturn mtk_cpu_dma_fatal(enum mtk_cpu_dma_fault reason, int error)
+{
+	/* Elect with local IRQs/preemption off: a same-CPU nested fault must
+	 * not park the selected reset executor before it reaches the firmware.
+	 * Never wait for a lock or run ordinary device shutdown from here.
+	 */
+	local_irq_disable();
+	preempt_disable();
+	if (!atomic_cmpxchg(&cpu_profile_fatal, 0, (int)reason ?: 1)) {
+		mtk_cpu_profile_note_fault(error);
+		reboot_mode = REBOOT_HARD;
+		machine_restart(NULL);
+	}
+	for (;;)
+		cpu_relax();
