+int system_bridge_update_ap_port(struct device *bridge, struct device *dev)
+{
+	static const struct { const char *name; unsigned int bit; } attrs[] = {
+		{ "hairpin_mode", 0 }, { "learning", 5 }, { "unicast_flood", 6 },
+		{ "proxyarp", 8 }, { "proxyarp_wifi", 10 }, { "multicast_flood", 11 },
+		{ "multicast_to_unicast", 12 }, { "vlan_tunnel", 13 },
+		{ "broadcast_flood", 14 }, { "neigh_suppress", 15 }, { "isolated", 16 },
+		{ "locked", 21 }, { "mab", 22 }, { "neigh_vlan_suppress", 23 },
+		{ "bpdu_filter", 24 },
+	};
+	uint64_t flags = ap_bridge_port_flags(bridge, dev);
+	char path[256], buf[32];
+	unsigned int i;
+	int fd, ret;
+	if (!ap_bridge_owner(dev)) {
+		system_bridge_set_wireless(bridge, dev);
+		system_bridge_set_isolated(dev, dev->wireless_bridge_isolate ||
+			((dev->settings.flags & DEV_OPT_ISOLATE) && dev->settings.isolate) ? "1" : "0");
+		system_bridge_set_bpdu_filter(dev, dev->bpdu_filter ? "1" : "0");
+		return 0;
+	}
+	for (i = 0; i < ARRAY_SIZE(attrs); i++) {
+		const char *value = flags & (1ULL << attrs[i].bit) ? "1" : "0";
+		snprintf(path, sizeof(path), "/sys/class/net/%s/brport/%s", dev->ifname, attrs[i].name);
+		fd = open(path, O_WRONLY | O_CLOEXEC);
