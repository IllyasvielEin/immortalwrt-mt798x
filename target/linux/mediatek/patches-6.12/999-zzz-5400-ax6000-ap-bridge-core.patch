+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_MTK_AP_BRIDGE_H
+#define _UAPI_LINUX_MTK_AP_BRIDGE_H
+#include <linux/types.h>
+
+#define MTK_AP_BRIDGE_ABI 1
+#define MTK_AP_BRIDGE_IOCTL 0x89ff /* SIOCDEVPRIVATE + 15 */
+#define MTK_AP_BRIDGE_MAX_DOMAINS 32
+#define MTK_AP_BRIDGE_MAX_TAGS 2
+#define MTK_AP_BRIDGE_VLAN_BYTES 512
+
+enum mtk_ap_bridge_op {
+	MTK_AP_BRIDGE_GET = 0,
+	MTK_AP_BRIDGE_PREPARE = 1,
+	MTK_AP_BRIDGE_STAGE_DOMAIN = 2,
+	MTK_AP_BRIDGE_COMMIT = 3,
+	MTK_AP_BRIDGE_ABORT = 4,
+};
+enum mtk_ap_bridge_state {
+	MTK_AP_BRIDGE_BLOCKED = 0,
+	MTK_AP_BRIDGE_READY = 1,
+	MTK_AP_BRIDGE_DEAD = 2,
+};
+#define MTK_AP_BRIDGE_NO_FORWARDING (1U << 0)
+#define MTK_AP_BRIDGE_NO_FORWARDING_BTNBSSID (1U << 1)
+#define MTK_AP_BRIDGE_POLICY_MASK 3U
+/* Stable bridge policy bits checked in both true and false directions. */
+#define MTK_AP_BRIDGE_PORT_FLAGS ((1ULL << 0) | (1ULL << 5) | (1ULL << 6) | \
+	(1ULL << 8) | (1ULL << 10) | (1ULL << 11) | (1ULL << 12) | \
+	(1ULL << 13) | (1ULL << 14) | (1ULL << 15) | (1ULL << 16) | \
+	(1ULL << 21) | (1ULL << 22) | (1ULL << 23) | (1ULL << 24))
+/* All integers use native byte order, including VLAN protocols (ETH_P_*).
+ * Bit n in each bitmap describes VID n, low bit first. VID 0 is forbidden.
+ * Entry zero must describe the base netdev (depth zero). Every VLAN child
+ * must have exactly one entry; tag[] describes direct parents, outer first.
+ */
+struct mtk_ap_bridge_tag {
+	__u32 ifindex;
+	__u16 proto;
+	__u16 vid;
+};
+struct mtk_ap_bridge_domain {
+	__u32 port_ifindex;
+	__u32 bridge_ifindex; /* zero explicitly requests standalone */
+	__aligned_u64 port_flags;
+	__u32 policy;
+	__u16 depth;
+	__u16 bridge_vlan_proto;
+	__u16 pvid;
+	__u16 bridge_pvid;
+	__u8 vlan_filtering;
+	__u8 reserved0[3];
+	struct mtk_ap_bridge_tag tag[MTK_AP_BRIDGE_MAX_TAGS];
+	__u8 vlans[MTK_AP_BRIDGE_VLAN_BYTES];
+	__u8 untagged[MTK_AP_BRIDGE_VLAN_BYTES];
+	__u8 bridge_vlans[MTK_AP_BRIDGE_VLAN_BYTES];
+	__u8 bridge_untagged[MTK_AP_BRIDGE_VLAN_BYTES];
+	__u32 reserved[4];
+};
+struct mtk_ap_bridge_request {
+	__u16 abi;
+	__u16 size;
+	__u32 op;
+	__u32 ifindex;
+	__u32 domain_index;
+	__aligned_u64 owner;
+	__aligned_u64 transaction;
+	__aligned_u64 lease;
+	__u32 domain_count;
+	__u32 state;
+	__s32 error;
+	__u8 driver_ready;
+	__u8 profile_ready;
+	__u8 blocked;
+	__u8 reserved0;
+	__u32 reserved[4];
+	struct mtk_ap_bridge_domain domain;
+};
+#endif
