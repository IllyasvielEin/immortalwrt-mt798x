+/* One timeout only cancels/wakes the existing HwCtrl actor. It never performs
+ * cleanup/reset and cannot cancel another cookie after the old work drains. */
+static void mtk_wifi_cpu_ser_timeout(struct work_struct *work)
+{
+	ERR_RECOVERY_CTRL_T *c = container_of(to_delayed_work(work),
+		ERR_RECOVERY_CTRL_T, cpu_ser_watchdog);
+	RTMP_ADAPTER *ad = container_of(c, RTMP_ADAPTER, ErrRecoveryCtl);
+	unsigned long flags;
+	bool wake = false;
+	spin_lock_irqsave(&c->cpu_ser_lock, flags);
+	if (c->cpu_ser_active && c->cpu_watchdog_cookie &&
+	    c->cpu_watchdog_cookie == c->warp_request.cookie) {
+		WRITE_ONCE(c->cpu_ser_error, -ETIMEDOUT);
+		WRITE_ONCE(c->warp_request.cancelled, 1);
+		xchg(&c->warp_request.permission, 2);
+		c->fe_result = -ETIMEDOUT;
+		complete(&c->fe_reset_done);
+		wake = true;
+	}
+	spin_unlock_irqrestore(&c->cpu_ser_lock, flags);
+	if (wake) RTCMDUp(&ad->HwCtrl.ser_task);
+}
+
+void mtk_wifi_cpu_ser_watchdog_start(RTMP_ADAPTER *ad, u64 cookie)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	unsigned long flags;
+	spin_lock_irqsave(&c->cpu_ser_lock, flags);
+	c->cpu_watchdog_cookie = cookie;
+	c->cpu_watchdog_drained = false;
+	spin_unlock_irqrestore(&c->cpu_ser_lock, flags);
+	/* mod_delayed_work_on is GPL-only; each old cycle is already drained. */
+	if (!queue_delayed_work(system_wq, &c->cpu_ser_watchdog, msecs_to_jiffies(20000)))
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_CONTROL_RACE, -EALREADY);
+}
+
+void mtk_wifi_cpu_ser_watchdog_cancel(RTMP_ADAPTER *ad)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	unsigned long flags;
+	spin_lock_irqsave(&c->cpu_ser_lock, flags);
+	c->cpu_watchdog_cookie = 0;
+	spin_unlock_irqrestore(&c->cpu_ser_lock, flags);
+	/* Called by HwCtrl without RTNL, never by the timeout callback. */
+	cancel_delayed_work_sync(&c->cpu_ser_watchdog);
+	c->cpu_watchdog_drained = true;
+}
