+static int cpu_proxy_empty_phase(struct mtk_warp_ser_request *r)
+{
+	if (!r->cookie || READ_ONCE(r->cancelled) || READ_ONCE(r->permission) == 2 ||
+	    time_after_eq(jiffies, r->deadline))
+		return -ECANCELED;
