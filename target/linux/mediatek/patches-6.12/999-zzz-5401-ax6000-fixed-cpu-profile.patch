+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_MTK_WARP_SER_H
+#define _LINUX_MTK_WARP_SER_H
+
+#include <linux/types.h>
+
+/* Synchronous, value-only D -> proxy -> W request; not a packet ABI. */
+enum mtk_warp_ser_phase {
+	MTK_WARP_SER_NONE,
+	MTK_WARP_SER_QUIESCE,
+	MTK_WARP_SER_STOP,
+	MTK_WARP_SER_CLEANUP,
+	MTK_WARP_SER_PREPARE,
+	MTK_WARP_SER_RESUME,
+	MTK_WARP_SER_COMPLETE,
+};
+
+struct mtk_warp_ser_request {
+	u64 cookie;
+	unsigned long deadline;
+	u32 phase;
+	u32 cancelled;
+	/* cmpxchg grant: 0 idle, 1 one mutation admitted, 2 cancelled forever. */
+	u32 permission;
+	int result;
+	u32 stop_proven;
+	u32 cleanup_done;
+};
+
+/* A positive vendor/FW status is an error too; only zero means success. */
+int warp_ser_checked(void *owner, struct mtk_warp_ser_request *request);
+
+#endif
