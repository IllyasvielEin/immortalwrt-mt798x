+#ifdef CONFIG_MTK_AP_BRIDGE
+/* The request permission is a linearization point, not a stale boolean read.
+ * ABORT changes 0/1 -> 2 permanently; release must never overwrite that 2. */
+static int mtk_wifi_ser_grant(ERR_RECOVERY_CTRL_T *c)
+{
+	if (READ_ONCE(c->cpu_ser_error) || READ_ONCE(c->warp_request.cancelled) ||
+	    time_after_eq(jiffies, c->warp_request.deadline))
+		return -ECANCELED;
+	return cmpxchg(&c->warp_request.permission, 0, 1) == 0 ? 0 : -ECANCELED;
+}
+
+static void mtk_wifi_ser_release(ERR_RECOVERY_CTRL_T *c)
+{
+	cmpxchg(&c->warp_request.permission, 1, 0);
+}
+
+int mtk_wifi_cpu_ser_phase(RTMP_ADAPTER *ad, u32 phase)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	struct mtk_warp_ser_request *r = &c->warp_request;
+	if (READ_ONCE(c->cpu_ser_error) || READ_ONCE(r->cancelled) ||
+	    READ_ONCE(r->permission) == 2 || time_after_eq(jiffies, r->deadline))
+		return -ECANCELED;
+	r->phase = phase;
+	r->result = -EINPROGRESS;
+	if (phase == MTK_WARP_SER_QUIESCE || phase == MTK_WARP_SER_STOP)
+		r->stop_proven = 0;
+	WLAN_HOOK_CALL(WLAN_HOOK_SER, ad, c);
+	if (READ_ONCE(c->cpu_ser_error) || READ_ONCE(r->cancelled) ||
+	    READ_ONCE(r->permission) == 2)
+		return -ECANCELED;
+	return r->result > 0 ? -EIO : r->result;
+}
+
+static NTSTATUS mtk_wifi_ser_fail(RTMP_ADAPTER *ad, int error)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	if (error >= 0) error = -EIO;
+	mtk_wifi_cpu_ser_watchdog_cancel(ad);
+	WRITE_ONCE(c->cpu_ser_error, error);
+	WRITE_ONCE(c->warp_request.cancelled, 1);
+	xchg(&c->warp_request.permission, 2);
+	mtk_cpu_profile_note_fault(error);
+	if (atomic_xchg(&c->notify_fe, 0))
+		mtk_cpu_wifi_stop_result(ad, c->fe_ser_cookie, error, false);
+	/* W proof never authorizes freeing a newly exposed D HIF. */
+	if (!c->warp_request.stop_proven || !c->cpu_hif_quiet)
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_STOP_FAILED, error);
+	if (c->cpu_cleanup) {
+		mtk_cpu_ser_cleanup_end(c->warp_request.cookie);
+		c->cpu_cleanup = false;
+	}
+	if (c->cpu_ser_active) {
+		mtk_cpu_wifi_ser_end(ad, c->warp_request.cookie);
+		c->cpu_ser_active = false;
+	}
+	return NDIS_STATUS_FAILURE; /* QUIESCENT_FAILED, sticky until reboot. */
+}
+
+static NTSTATUS mtk_wifi_cpu_recover(RTMP_ADAPTER *ad)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	struct mtk_warp_ser_request *r = &c->warp_request;
+	u32 status = ad->HwCtrl.ser_status;
+	u32 stage = READ_ONCE(c->errRecovStage);
+	unsigned long irq_flags;
+	int ret;
+	if (READ_ONCE(c->cpu_ser_error))
+		return c->cpu_ser_active ? mtk_wifi_ser_fail(ad, c->cpu_ser_error) : NDIS_STATUS_FAILURE;
+	switch (stage) {
+	case ERR_RECOV_STAGE_STOP_IDLE:
+		if (!(status & ERROR_DETECT_STOP_PDMA)) return NDIS_STATUS_INVALID_DATA;
+		spin_lock_irqsave(&c->cpu_ser_lock, irq_flags);
+		if (c->cpu_ser_error || c->cpu_ser_active) {
+			spin_unlock_irqrestore(&c->cpu_ser_lock, irq_flags);
+			return NDIS_STATUS_FAILURE;
+		}
+		memset(r, 0, sizeof(*r));
+		ret = mtk_cpu_wifi_ser_begin(ad, atomic_read(&c->notify_fe) ? c->fe_ser_cookie : 0, &r->cookie);
+		if (!ret) c->cpu_ser_active = true;
+		r->deadline = jiffies + msecs_to_jiffies(5000);
+		spin_unlock_irqrestore(&c->cpu_ser_lock, irq_flags);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		mtk_wifi_cpu_ser_watchdog_start(ad, r->cookie);
+		mtk_ap_adapter_ser_drain(ad);
+		ret = mtk_wifi_cpu_ser_phase(ad, MTK_WARP_SER_QUIESCE);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ErrRecoverySetRecovStage(c, ERR_RECOV_STAGE_STOP_IDLE_DONE);
+		ErrRecoverySetStopRxDMA(c, FALSE);
+		ret = ErrRecoveryMcuIntEvent(ad, MCU_INT_PDMA0_STOP_DONE) == TRUE ? 0 : -EIO;
+		mtk_wifi_ser_release(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		/* Preserve the existing bounded MMIO-off interval after N9 stop. */
+		{
+			PCI_HIF_T *hif = hc_get_hif_ctrl(ad->hdev_ctrl);
+			ULONG flags = 0;
+			RTMP_SPIN_LOCK_IRQSAVE(&hif->io_remap_lock, &flags);
+			hif->bPCIclkOff = TRUE;
+			RTMP_SPIN_UNLOCK_IRQRESTORE(&hif->io_remap_lock, &flags);
+			RtmpusecDelay(100 * 1000);
+			RTMP_SPIN_LOCK_IRQSAVE(&hif->io_remap_lock, &flags);
+			hif->bPCIclkOff = FALSE;
+			RTMP_SPIN_UNLOCK_IRQRESTORE(&hif->io_remap_lock, &flags);
+		}
+		if (READ_ONCE(r->cancelled)) return mtk_wifi_ser_fail(ad, -ECANCELED);
+		ErrRecoverySetRecovStage(c, ERR_RECOV_STAGE_STOP_PDMA0);
+		return NDIS_STATUS_SUCCESS;
+	case ERR_RECOV_STAGE_STOP_PDMA0:
+		if (!(status & ERROR_DETECT_RESET_DONE)) return NDIS_STATUS_INVALID_DATA;
+		ret = mtk_wifi_cpu_ser_phase(ad, MTK_WARP_SER_STOP);
+		if (ret || !r->stop_proven) return mtk_wifi_ser_fail(ad, ret ?: -EPROTO);
+		ErrRecoverySetStopRxDMA(c, TRUE);
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ret = chip_set_hif_dma(ad, DMA_TX_RX, FALSE) == TRUE ? 0 : -EIO;
+		if (!ret) {
+			int ms = jiffies_to_msecs(r->deadline - jiffies);
+			int rounds = ms > 402 ? 200 : ms / 2 - 1;
+			if (rounds < 1 || !chip_wait_hif_dma_idle(ad, ALL_DMA, rounds, 1000)) ret = -ETIMEDOUT;
+		}
+		if (!ret) c->cpu_hif_quiet = true;
+		mtk_wifi_ser_release(c);
+		if (ret || time_after_eq(jiffies, r->deadline)) return mtk_wifi_ser_fail(ad, ret ?: -ETIMEDOUT);
+		if (atomic_xchg(&c->notify_fe, 0)) {
+			ret = mtk_wifi_ser_grant(c);
+			if (ret) return mtk_wifi_ser_fail(ad, ret);
+			ret = mtk_cpu_wifi_stop_result(ad, c->fe_ser_cookie, 0, true);
+			mtk_wifi_ser_release(c);
+			if (ret) return mtk_wifi_ser_fail(ad, ret);
+			if (!wait_for_completion_timeout(&c->fe_reset_done, msecs_to_jiffies(10000)))
+				return mtk_wifi_ser_fail(ad, -ETIMEDOUT);
+			if (READ_ONCE(c->fe_result)) return mtk_wifi_ser_fail(ad, c->fe_result);
+		}
+		/* Independent WiFi SER has no FE wait or synthetic FE ACK. */
+		r->deadline = jiffies + msecs_to_jiffies(5000);
+		ret = mtk_wifi_cpu_ser_phase(ad, MTK_WARP_SER_CLEANUP);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		c->cpu_saved_flags = ad->Flags;
+		RTMP_CLEAR_FLAG(ad, fRTMP_ADAPTER_START_UP | fRTMP_ADAPTER_MCU_SEND_IN_BAND_CMD);
+		ret = mtk_cpu_ser_cleanup_begin(r->cookie);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		c->cpu_cleanup = true;
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		{
+			PKT_TOKEN_CB *token = hc_get_ct_cb(ad->hdev_ctrl);
+			ret = mtk_wifi_cpu_queues_stop(ad);
+			if (!ret) {
+				chip_interrupt_disable(ad);
+				hif_reset_task_group(ad->hdev_ctrl);
+				hif_free_irq(ad->hdev_ctrl);
+				hif_reset_txrx_mem(ad->hdev_ctrl);
+				token_deinit(&token);
+			}
+		}
+		mtk_wifi_ser_release(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ret = WfHifInit(ad);
+		if (!ret) {
+			ret = qm_init(ad);
+			if (!ret) c->cpu_qm_live = true;
+		}
+		if (!ret) {
+			ret = tm_init(ad);
+			if (!ret) c->cpu_tm_live = true;
+		}
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ret = mtk_wifi_cpu_ser_phase(ad, MTK_WARP_SER_RESUME);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		RTMP_SET_FLAG(ad, c->cpu_saved_flags &
+			(fRTMP_ADAPTER_START_UP | fRTMP_ADAPTER_MCU_SEND_IN_BAND_CMD));
+		chip_interrupt_enable(ad);
+		hif_dma_enable(ad->hdev_ctrl);
+		ret = chip_set_hif_dma(ad, DMA_TX_RX, TRUE) == TRUE ? 0 : -EIO;
+		if (ret) {
+			mtk_wifi_ser_release(c);
+			return mtk_wifi_ser_fail(ad, ret);
+		}
+		ErrRecoverySetRecovStage(c, ERR_RECOV_STAGE_RESET_PDMA0);
+		ErrRecoverySetStopRxDMA(c, FALSE);
+		ret = ErrRecoveryMcuIntEvent(ad, MCU_INT_PDMA0_INIT_DONE) == TRUE ? 0 : -EIO;
+		mtk_wifi_ser_release(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		mtk_cpu_ser_cleanup_end(r->cookie);
+		c->cpu_cleanup = false;
+		return NDIS_STATUS_SUCCESS;
+	case ERR_RECOV_STAGE_RESET_PDMA0:
+		if (!(status & ERROR_DETECT_RECOVERY_DONE)) return NDIS_STATUS_INVALID_DATA;
+		ret = mtk_cpu_ser_cleanup_begin(r->cookie);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		c->cpu_cleanup = true;
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ErrRecoverySetRecovStage(c, ERR_RECOV_STAGE_WAIT_N9_NORMAL);
+		ret = ErrRecoveryMcuIntEvent(ad, MCU_INT_PDMA0_RECOVERY_DONE) == TRUE ? 0 : -EIO;
+		mtk_wifi_ser_release(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		mtk_cpu_ser_cleanup_end(r->cookie);
+		c->cpu_cleanup = false;
+		return NDIS_STATUS_SUCCESS;
+	case ERR_RECOV_STAGE_WAIT_N9_NORMAL:
+		if (!(status & ERROR_DETECT_N9_NORMAL_STATE) || (status & ERROR_DETECT_STOP_PDMA))
+			return mtk_wifi_ser_fail(ad, -EPROTO);
+		ret = mtk_wifi_cpu_ser_phase(ad, MTK_WARP_SER_COMPLETE);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		mtk_wifi_cpu_ser_watchdog_cancel(ad);
+		ret = mtk_cpu_ser_cleanup_begin(r->cookie);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		c->cpu_cleanup = true;
+		ret = mtk_wifi_ser_grant(c);
+		if (ret) return mtk_wifi_ser_fail(ad, ret);
+		ErrRecoveryEndDriverRestore(ad);
+		ba_refresh_bar_all(ad);
+		{
+			unsigned int i;
+			for (i = 0; i < WDEV_NUM_MAX; i++) {
+				struct wifi_dev *wdev = ad->wdev_list[i];
+				if (wdev && HcIsRadioAcq(wdev) && wdev->wdev_type == WDEV_TYPE_AP) {
+					UpdateBeaconHandler(ad, wdev, BCN_UPDATE_ALL_AP_RENEW);
+					break;
+				}
+			}
+		}
+		mtk_wifi_ser_release(c);
+		mtk_cpu_ser_cleanup_end(r->cookie);
+		c->cpu_cleanup = false;
+		spin_lock_irqsave(&c->cpu_ser_lock, irq_flags);
+		if (c->cpu_ser_error || r->cancelled || r->permission == 2) {
+			spin_unlock_irqrestore(&c->cpu_ser_lock, irq_flags);
+			return mtk_wifi_ser_fail(ad, -ECANCELED);
+		}
+		mtk_cpu_wifi_ser_end(ad, r->cookie);
+		c->cpu_ser_active = false;
+		WRITE_ONCE(c->fe_ser_cookie, 0);
+		ErrRecoverySetRecovStage(c, ERR_RECOV_STAGE_STOP_IDLE);
+		spin_unlock_irqrestore(&c->cpu_ser_lock, irq_flags);
+		return NDIS_STATUS_SUCCESS;
+	default:
+		return mtk_wifi_ser_fail(ad, -EPROTO);
+	}
+}
