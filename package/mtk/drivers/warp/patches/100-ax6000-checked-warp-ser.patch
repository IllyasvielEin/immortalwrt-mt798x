+#ifdef CONFIG_MTK_AP_BRIDGE
+/* Called with the W control mutex held and ordinary producers drained. */
+int warp_checked_prepare(struct warp_entry *warp,
+			 struct mtk_warp_ser_request *r)
+{
+	struct wed_entry *wed = &warp->wed;
+	struct warp_checked_state *s = &wed->checked;
+	struct wdma_entry *wdma = &warp->wdma;
+	struct wifi_entry *wifi = &warp->wifi;
+	int ret;
+
+	ret = warp_checked_budget(r);
+	if (ret < 0 || s->resources)
+		return ret < 0 ? ret : -EALREADY;
+	/* This allocator has no hardware writes; its error unwind is unexposed. */
+	ret = wed_rx_bm_init(wed, &wifi->hw);
+	if (ret)
+		return ret < 0 ? ret : -ENOMEM;
+	s->resources = true;
+#ifdef WED_DYNAMIC_RXBM_SUPPORT
+	if (IS_WED_HW_CAP(wed, WED_HW_CAP_DYN_RXBM) && !wed->dybm_ul_tasks) {
+		ret = regist_ul_dybm_task(wed);
+		if (ret)
+			return ret < 0 ? ret : -ENOMEM;
+	}
+#endif
+	ret = warp_checked_grant(r);
+	if (ret)
+		return ret;
+	/* An address publication invalidates the proof for the former resource. */
+	r->stop_proven = 0;
+	s->quiescent = false;
+	s->exposed = true;
+	s->preparing = true;
+	s->deadline = r->deadline;
+	warp_wed_init_hw(wed, wdma);
+	warp_wdma_init_hw(wed, wdma, warp->idx);
+	warp_wdma_ring_init_hw(wed, wdma);
+	ret = warp_tx_ring_init_hw(wed, wifi);
+	if (!ret)
+		ret = warp_rx_ring_init_hw(wed, wifi);
+	if (!ret)
+		ret = warp_checked_bm_prepare_hw(warp);
+	if (!ret)
+		ret = warp_rx_data_ring_init_hw(wed, wifi);
+	if (!ret)
+		ret = warp_rx_bm_init_hw(wed, wifi);
+	if (!ret)
+		ret = warp_rx_rro_init_hw(wed, wifi);
+	if (!ret)
+		ret = warp_rx_route_qm_init_hw(wed, wifi);
+	s->preparing = false;
+	warp_checked_release(r);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+#ifdef CONFIG_WED_HW_RRO_SUPPORT
+	ret = warp_set_rrocfg(wed, warp->idx, &wifi->hw, ret);
+	if (ret != WARP_OK_STATUS)
+		return ret == -ETIMEDOUT ? ret : -EREMOTEIO;
+#endif
+	return warp_checked_budget(r) < 0 ? warp_checked_budget(r) : 0;
+}
+
+int warp_checked_resume(struct warp_entry *warp,
+			struct mtk_warp_ser_request *r)
+{
+	struct wed_entry *wed = &warp->wed;
+	struct warp_checked_state *s = &wed->checked;
+	struct warp_bus *bus = warp_bus_get();
+	unsigned long flags;
+	int ret;
+
+	if (!s->resources || !s->exposed || s->error)
+		return -EPROTO;
+	ret = warp_checked_grant(r);
+	if (ret)
+		return ret;
+	r->stop_proven = 0;
+	s->quiescent = false;
+	WRITE_ONCE(s->enable_actor, (unsigned long)current);
+	/* A later ordinary ifup can also inherit a stopped WO from ifdown. */
+	if (warp->woif.wo_ctrl.cur_state == WO_STATE_SER_RESET)
+		ret = warp_checked_wo(warp, WO_STATE_ENABLE, r);
+	else if (!r->cookie && warp->woif.wo_ctrl.cur_state == WO_STATE_ENABLE)
+		ret = 0;
+	else
+		ret = -EPROTO;
+	if (!ret)
+		ret = warp_checked_hw_enable(warp, r);
+	if (!ret) {
+		warp_int_ctrl_hw(wed, &warp->wifi, &warp->wdma, ALL_INT_AGENT,
+				 true, bus->pcie_ints_offset, warp->idx);
+		warp_eint_init_hw(wed);
+		warp_eint_ctrl_hw(wed, true);
+		if (warp->cfg.atc_en) {
+			wifi_chip_atc_set(&warp->wifi, true);
+			warp_atc_set_hw(&warp->wifi, bus, warp->idx, true);
+		}
+	}
+	WRITE_ONCE(s->enable_actor, 0);
+	warp_checked_release(r);
+	if (ret)
+		return ret;
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	spin_lock_irqsave(&s->gate, flags);
+	if (READ_ONCE(r->cancelled) || READ_ONCE(r->permission) == 2 ||
+	    mtk_cpu_profile_is_fatal())
+		ret = -ECANCELED;
+	else {
+		s->stopping = false;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&s->gate, flags);
+	return ret;
+}
+
+int warp_checked_cold_init(struct warp_entry *warp)
+{
+	struct warp_checked_state *s = &warp->wed.checked;
+	struct mtk_warp_ser_request r = {
+		.deadline = jiffies + msecs_to_jiffies(5000),
+	};
+	unsigned long flags;
+	int ret;
+	if (!s->initialized)
+		return -ENODEV;
+	mutex_lock(&s->control);
+	if (s->phase || s->resources || s->exposed || s->error) {
+		ret = -EBUSY;
+		goto out;
+	}
+	spin_lock_irqsave(&s->gate, flags);
+	s->stopping = true;
+	spin_unlock_irqrestore(&s->gate, flags);
+	ret = warp_checked_budget(&r);
+	if (ret < 0 || !wait_event_timeout(s->drained, !READ_ONCE(s->active),
+				msecs_to_jiffies(ret))) {
+		ret = -ETIMEDOUT;
+		goto failed;
+	}
+	warp_checked_bm_drain(&warp->wed);
+	ret = warp_checked_prepare(warp, &r);
+	if (!ret)
+		ret = warp_checked_resume(warp, &r);
+	if (!ret)
+		goto out;
+failed:
+	s->error = ret;
+	mtk_cpu_profile_note_fault(ret);
+	if (s->exposed) {
+		mutex_unlock(&s->control);
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_INIT_EXPOSED, ret);
+	}
+out:
+	mutex_unlock(&s->control);
+	return ret;
+}
