+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_cpu_profile.c
@@ -0,0 +1,344 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* AX6000 fixed CPU forwarding product: permanently owned, empty FOE tables.
+ * This object replaces the legacy HNAT producer objects at Kbuild time.
+ */
+#include <linux/bitfield.h>
+#include <linux/dma-mapping.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/mtk_cpu_profile.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/rtnetlink.h>
+#include "hnat.h"
+
+struct mtk_hnat *hnat_priv;
+static bool cpu_exposed;
+static bool cpu_published;
+static int cpu_error;
+static DEFINE_MUTEX(cpu_probe_lock);
+static bool cpu_claimed;
+
+/* Resource ownership does not follow enable, an ioctl, or a SER cycle. */
+static int cpu_write(void __iomem *reg, u32 value, u32 mask)
+{
+	writel(value, reg);
+	return (readl(reg) & mask) == (value & mask) ? 0 : -EIO;
+}
+
+static int cpu_gmacs(struct mtk_hnat *h)
+{
+	unsigned int i;
+	void __iomem *reg;
+	u32 value;
+	int ret;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		if (!h->eth->mac[i])
+			continue;
+		reg = h->fe_base + MTK_GDMA_FWD_CFG(i);
+		value = readl(reg) & ~GDM_ALL_FRC_MASK;
+		value |= BITS_GDM_ALL_FRC_P_CPU_PDMA;
+		ret = cpu_write(reg, value, GDM_ALL_FRC_MASK);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int cpu_ppe(struct mtk_hnat *h, unsigned int i)
+{
+	void __iomem *base = h->ppe_base[i];
+	u32 value, table;
+	int ret;
+
+	/* No traffic is re-enabled by the FE owner until this checked restore
+	 * returns. The DMA allocation and its address never change after probe.
+	 */
+	value = readl(base + PPE_GLO_CFG);
+	value &= ~(PPE_EN | TSID_EN | TTL0_DRP | MCAST_TB_EN |
+		   NEW_IPV4_ID_INC_EN | SP_CMP_EN);
+	writel(value, base + PPE_GLO_CFG);
+	writel(0, base + PPE_FLOW_CFG);
+	ret = readl_poll_timeout(base + PPE_GLO_CFG, value,
+				 !(value & BIT(31)), 10, 1000000);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_CAH_CTRL, 0, CAH_EN | CAH_X_MODE | CAH_REQ);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(base + PPE_CAH_DBG, value,
+				 !(value & CAH_DBG_BUSY), 10, 100000);
+	if (ret)
+		return ret;
+	/* Invalidate with cache disabled, and keep it disabled. No preserved
+	 * cache-line writer, automatic learning or asynchronous refill exists.
+	 */
+	writel(CAH_X_MODE, base + PPE_CAH_CTRL);
+	ret = cpu_write(base + PPE_CAH_CTRL, 0, CAH_EN | CAH_X_MODE | CAH_REQ);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(base + PPE_CAH_DBG, value,
+				 !(value & CAH_DBG_BUSY), 10, 100000);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_FLOW_CFG, 0, U32_MAX);
+	if (ret)
+		return ret;
+	table = FIELD_PREP(TB_ETRY_NUM, h->etry_num_cfg) |
+		FIELD_PREP(TB_ENTRY_SIZE, ENTRY_96B) |
+		FIELD_PREP(SMA, SMA_ONLY_FWD_CPU);
+	ret = cpu_write(base + PPE_TB_CFG, table,
+		       TB_ETRY_NUM | TB_ENTRY_SIZE | SMA | NTU_AGE | UNBD_AGE |
+		       TCP_AGE | UDP_AGE | FIN_AGE | KA_CFG | SCAN_MODE | XMODE);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_TB_BASE, lower_32_bits(h->foe_table_dev[i]), U32_MAX);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_DFT_CPORT, 0, U32_MAX);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_DFT_CPORT1, 0, U32_MAX);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_KA, 0, U32_MAX);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_BIND_LMT_0, 0, QURT_LMT | HALF_LMT);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_BIND_LMT_1, 0, FULL_LMT | NTU_KA);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_MIB_CFG, 0, MIB_EN | MIB_READ_CLEAR);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_MIB_CAH_CTRL, 0, MIB_CAH_EN);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_MIB_TB_BASE, 0, U32_MAX);
+	if (ret)
+		return ret;
+	ret = cpu_write(base + PPE_MCAST_PPSE, 0, U32_MAX);
+	if (ret)
+		return ret;
+	/* WED still has a valid PPE slow-path target. No entry is BIND, no
+	 * classifier builds entries, no multicast/sampling/HQOS producer runs.
+	 */
+	value = readl(base + PPE_GLO_CFG);
+	value &= ~(TSID_EN | TTL0_DRP | MCAST_TB_EN | NEW_IPV4_ID_INC_EN | SP_CMP_EN);
+	value |= PPE_EN;
+	ret = cpu_write(base + PPE_GLO_CFG, value,
+			PPE_EN | TSID_EN | TTL0_DRP | MCAST_TB_EN |
+			NEW_IPV4_ID_INC_EN | SP_CMP_EN);
+	if (ret)
+		return ret;
+	/* Preserve the WED -> PPE slow path, independent of optional hooks. */
+	value = i ? NR_PPE1_PORT : NR_PPE0_PORT;
+	base = h->fe_base + MTK_FE_GLO_CFG(value);
+	table = MTK_FE_LINK_DOWN_P(value);
+	return cpu_write(base, readl(base) & ~table, table);
+}
+
+static int hnat_cpu_restore(void *context)
+{
+	struct mtk_hnat *h = context;
+	size_t size = h->foe_etry_num * sizeof(struct foe_entry);
+	unsigned int i;
+	int ret;
+
+	ASSERT_RTNL();
+	if (cpu_error)
+		return cpu_error;
+	/* This profile has no legal writer. Unexpected content is a fault,
+	 * never an excuse to silently clear BINDs and report a healthy restore.
+	 */
+	dma_rmb();
+	for (i = 0; i < h->ppe_num; i++) {
+		if (!h->foe_table_cpu[i] || upper_32_bits(h->foe_table_dev[i]) ||
+		    memchr_inv(h->foe_table_cpu[i], 0, size)) {
+			ret = -EUCLEAN;
+			goto failed;
+		}
+	}
+	cpu_exposed = true; /* No error after the first HW touch may free tables. */
+	ret = cpu_gmacs(h);
+	if (ret)
+		goto failed;
+	for (i = 0; i < h->ppe_num; i++) {
+		ret = cpu_ppe(h, i);
+		if (ret)
+			goto failed;
+	}
+	return 0;
+failed:
+	cpu_error = ret;
+	mtk_cpu_profile_note_fault(ret);
+	return ret;
+}
+
+static const struct mtk_hnat_data hnat_cpu_data = {
+	.num_of_sch = 4,
+	.whnat = true,
+	.per_flow_accounting = false,
+	.mcast = false,
+	.version = MTK_HNAT_V2,
+};
+
+const struct of_device_id of_hnat_match[] = {
+	{ .compatible = "mediatek,mtk-hnat_v4", .data = &hnat_cpu_data },
+	{},
+};
+MODULE_DEVICE_TABLE(of, of_hnat_match);
+
+static int hnat_cpu_probe(struct platform_device *pdev)
+{
+	struct device_node *eth_node;
+	struct platform_device *eth_pdev;
+	struct mtk_hnat *h;
+	struct resource *res;
+	size_t size = DEF_ETRY_NUM * sizeof(struct foe_entry);
+	u32 ppe_num;
+	unsigned int i;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct foe_entry) != 96);
+	mutex_lock(&cpu_probe_lock);
+	if (cpu_claimed) {
+		mutex_unlock(&cpu_probe_lock);
+		return -EBUSY;
+	}
+	cpu_claimed = true;
+	mutex_unlock(&cpu_probe_lock);
+	eth_node = of_parse_phandle(pdev->dev.of_node, "mtketh-soc", 0);
+	if (!eth_node) {
+		ret = -EINVAL;
+		goto unclaim;
+	}
+	eth_pdev = of_find_device_by_node(eth_node);
+	of_node_put(eth_node);
+	if (!eth_pdev) {
+		ret = -EPROBE_DEFER;
+		goto unclaim;
+	}
+	h = kzalloc(sizeof(*h), GFP_KERNEL);
+	if (!h) {
+		ret = -ENOMEM;
+		goto put_eth;
+	}
+	h->eth = platform_get_drvdata(eth_pdev);
+	if (!h->eth) {
+		ret = -EPROBE_DEFER;
+		goto free_context;
+	}
+	ret = of_property_read_u32(pdev->dev.of_node, "mtketh-ppe-num", &ppe_num);
+	if (ret || ppe_num != MAX_PPE_NUM || MAX_PPE_NUM != 2) {
+		ret = -EINVAL;
+		goto free_context;
+	}
+	h->dev = &pdev->dev;
+	h->data = &hnat_cpu_data;
+	h->ppe_num = ppe_num;
+	h->foe_etry_num = DEF_ETRY_NUM;
+	h->etry_num_cfg = DEF_ETRY_NUM_CFG;
+	h->wan_dsa_port = NONE_DSA_PORT;
+	spin_lock_init(&h->entry_lock);
+	spin_lock_init(&h->cah_lock);
+	spin_lock_init(&h->flow_entry_lock);
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < 0x2800) {
+		ret = -EINVAL;
+		goto free_context;
+	}
+	h->fe_base = devm_ioremap(h->dev, res->start, resource_size(res));
+	if (!h->fe_base) {
+		ret = -ENOMEM;
+		goto free_context;
+	}
+	h->ppe_base[0] = h->fe_base + 0x2200;
+	h->ppe_base[1] = h->fe_base + 0x2600;
+	ret = dma_set_mask_and_coherent(h->dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto free_context;
+	/* All allocations are complete and explicitly zero before any DMA BASE
+	 * is published. No per-flow, MIB or pending-bind allocations exist.
+	 */
+	for (i = 0; i < h->ppe_num; i++) {
+		h->foe_table_cpu[i] = dma_alloc_coherent(h->dev, size,
+						      &h->foe_table_dev[i], GFP_KERNEL);
+		if (!h->foe_table_cpu[i]) {
+			ret = -ENOMEM;
+			goto free_tables;
+		}
+		memset(h->foe_table_cpu[i], 0, size);
+		if (upper_32_bits(h->foe_table_dev[i])) {
+			ret = -EOVERFLOW;
+			goto free_tables;
+		}
+	}
+	dma_wmb();
+	hnat_priv = h;
+	platform_set_drvdata(pdev, h);
+	/* The same permanent callback owns cold preparation and every FE SER. */
+	rtnl_lock();
+	ret = hnat_cpu_restore(h);
+	if (!ret) {
+		/* Publication is a lifetime promise even if register returns error. */
+		cpu_published = true;
+		ret = mtk_cpu_profile_register(h->eth->dev, hnat_cpu_restore, h);
+	}
+	rtnl_unlock();
+	if (ret) {
+		cpu_error = ret;
+		mtk_cpu_profile_note_fault(ret);
+		dev_err(h->dev, "CPU profile fault %d; retaining permanent DMA ownership\n", ret);
+	}
+	if (cpu_exposed || cpu_published) {
+		/* A successful bind retains devres MMIO and context on HW failure.
+		 * This driver has no exit/unbind path; remove is fail-stop below.
+		 */
+		get_device(h->dev);
+		return 0;
+	}
+	hnat_priv = NULL;
+	platform_set_drvdata(pdev, NULL);
+free_tables:
+	for (i = 0; i < h->ppe_num; i++)
+		if (h->foe_table_cpu[i])
+			dma_free_coherent(h->dev, size, h->foe_table_cpu[i], h->foe_table_dev[i]);
+free_context:
+	kfree(h);
+put_eth:
+	put_device(&eth_pdev->dev);
+unclaim:
+	mutex_lock(&cpu_probe_lock);
+	cpu_claimed = false;
+	mutex_unlock(&cpu_probe_lock);
+	return ret;
+}
+
+static void hnat_cpu_remove(struct platform_device *pdev)
+{
+	/* No live control may release a published callback or DMA allocation. */
+	mtk_cpu_dma_fatal(MTK_CPU_DMA_CONTROL_RACE, -EBUSY);
+}
+
+static struct platform_driver hnat_cpu_driver = {
+	.probe = hnat_cpu_probe,
+	.remove = hnat_cpu_remove,
+	.driver = {
+		.name = "mediatek_soc_hnat",
+		.of_match_table = of_hnat_match,
+		.suppress_bind_attrs = true,
+	},
+};
+
+static int __init hnat_cpu_init(void)
+{
+	return platform_driver_register(&hnat_cpu_driver);
+}
+module_init(hnat_cpu_init); /* Deliberately no module_exit. */
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("AX6000 permanent CPU forwarding PPE slow-path profile");
