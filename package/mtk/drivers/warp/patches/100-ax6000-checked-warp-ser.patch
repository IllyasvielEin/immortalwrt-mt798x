+++ b/warp_checked.c
@@ -0,0 +1,370 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include "warp.h"
+#include "warp_bm.h"
+#include "warp_hw.h"
+#include "mcu/warp_woif.h"
+#include <linux/mtk_cpu_profile.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+
+void warp_checked_init(struct warp_entry *warp)
+{
+	struct warp_checked_state *s = &warp->wed.checked;
+	mutex_init(&s->control);
+	spin_lock_init(&s->gate);
+	init_waitqueue_head(&s->drained);
+	s->initialized = true;
+	s->stopping = true;
+}
+
+bool warp_checked_enter(struct wed_entry *wed)
+{
+	struct warp_checked_state *s = &wed->checked;
+	unsigned long flags;
+	bool allowed;
+	if (!s->initialized || mtk_cpu_profile_is_fatal())
+		return false;
+	spin_lock_irqsave(&s->gate, flags);
+	allowed = !s->stopping && !s->error && !mtk_cpu_profile_is_fatal();
+	if (allowed)
+		s->active++;
+	spin_unlock_irqrestore(&s->gate, flags);
+	return allowed;
+}
+
+/* A mapped-but-denied access must be reported as handled by the proxy:
+ * a negative return would make D fall back to unguarded native MMIO.
+ * Only the narrow N9 interrupt lane is available to IRQ/tasklet context.
+ * Planned ring programming requires the actual current lifecycle actor.
+ */
+bool warp_checked_io_enter(struct warp_entry *warp, u32 addr, bool write,
+			   u32 *value)
+{
+	struct warp_checked_state *s = &warp->wed.checked;
+	struct wifi_hw *hw = &warp->wifi.hw;
+	unsigned long flags;
+	bool control, allowed = false;
+	u32 read_mask = ~0U;
+
+	if (!s->initialized || mtk_cpu_profile_is_fatal())
+		return false;
+	control = mtk_cpu_control_permitted(hw->priv, READ_ONCE(s->cookie));
+	spin_lock_irqsave(&s->gate, flags);
+	if (!mtk_cpu_profile_is_fatal()) {
+		if (!s->stopping && !s->error)
+			allowed = true;
+		else if (s->control_irq &&
+			 (addr == hw->int_sta || addr == hw->int_mask)) {
+			allowed = true;
+			if (write)
+				*value &= WARP_CONTROL_IRQ;
+			else
+				read_mask = WARP_CONTROL_IRQ;
+		} else if (control)
+			allowed = true;
+	}
+	if (allowed) {
+		if (!write)
+			*value = read_mask;
+		s->active++;
+	}
+	spin_unlock_irqrestore(&s->gate, flags);
+	return allowed;
+}
+
+void warp_checked_exit(struct wed_entry *wed)
+{
+	struct warp_checked_state *s = &wed->checked;
+	unsigned long flags;
+	spin_lock_irqsave(&s->gate, flags);
+	if (WARN_ON_ONCE(!s->active)) {
+		spin_unlock_irqrestore(&s->gate, flags);
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_CONTROL_RACE, -EINVAL);
+	}
+	if (!--s->active)
+		wake_up_all(&s->drained);
+	spin_unlock_irqrestore(&s->gate, flags);
+}
+
+/* Queue admission and stopping publication use the same short lock. */
+void warp_checked_tasklet(struct wed_entry *wed, struct tasklet_struct *task,
+			  bool high)
+{
+	struct warp_checked_state *s = &wed->checked;
+	unsigned long flags;
+	spin_lock_irqsave(&s->gate, flags);
+	if (!s->stopping && !s->error && !mtk_cpu_profile_is_fatal()) {
+		if (high)
+			tasklet_hi_schedule(task);
+		else
+			tasklet_schedule(task);
+	}
+	spin_unlock_irqrestore(&s->gate, flags);
+}
+
+void warp_checked_timer(struct wed_entry *wed, struct timer_list *timer,
+			unsigned long expires)
+{
+	struct warp_checked_state *s = &wed->checked;
+	unsigned long flags;
+	spin_lock_irqsave(&s->gate, flags);
+	if (!s->stopping && !s->error && !mtk_cpu_profile_is_fatal())
+		mod_timer(timer, expires);
+	spin_unlock_irqrestore(&s->gate, flags);
+}
+
+int warp_checked_budget(struct mtk_warp_ser_request *r)
+{
+	unsigned long remain, now = READ_ONCE(jiffies);
+	if (READ_ONCE(r->cancelled) || READ_ONCE(r->permission) == 2 ||
+	    mtk_cpu_profile_is_fatal())
+		return -ECANCELED;
+	if (time_after_eq(now, r->deadline))
+		return -ETIMEDOUT;
+	remain = jiffies_to_msecs(r->deadline - now);
+	/* Never pass zero to the legacy message code, where it means 3000ms. */
+	return remain ? (int)min_t(unsigned long, remain, INT_MAX) : -ETIMEDOUT;
+}
+
+int warp_checked_grant(struct mtk_warp_ser_request *r)
+{
+	int ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	return cmpxchg(&r->permission, 0U, 1U) == 0 ? 0 : -ECANCELED;
+}
+
+void warp_checked_release(struct mtk_warp_ser_request *r)
+{
+	/* A concurrent cancellation is permanent, never overwritten here. */
+	cmpxchg(&r->permission, 1U, 0U);
+}
+
+static int warp_checked_quiesce(struct warp_entry *warp,
+			       struct mtk_warp_ser_request *r)
+{
+	struct wed_entry *wed = &warp->wed;
+	struct warp_checked_state *s = &wed->checked;
+	struct warp_bus *bus = warp_bus_get();
+	unsigned long flags, remaining;
+	int ret;
+
+	spin_lock_irqsave(&s->gate, flags);
+	s->stopping = true;
+	s->control_irq = false;
+	spin_unlock_irqrestore(&s->gate, flags);
+	/* Existing runners are finite; queued wrappers cannot enter/requeue. */
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	remaining = msecs_to_jiffies(ret);
+	if (!wait_event_timeout(s->drained, !READ_ONCE(s->active), remaining))
+		return -ETIMEDOUT;
+	warp_checked_bm_drain(wed);
+	ret = warp_checked_grant(r);
+	if (ret)
+		return ret;
+	if (warp->cfg.atc_en) {
+		wifi_chip_atc_set(&warp->wifi, false);
+		warp_atc_set_hw(&warp->wifi, bus, warp->idx, false);
+	}
+	if (!s->probe_complete) {
+		warp_checked_release(r);
+		return s->exposed ? -EPROTO : 0;
+	}
+	/* CCIF/WO response channels are deliberately kept alive. */
+	warp_eint_ctrl_hw(wed, false);
+	warp_int_ctrl_hw(wed, &warp->wifi, &warp->wdma, WDMA_INT_AGENT,
+			 false, bus->pcie_ints_offset, warp->idx);
+	/* N9 RESET_DONE arrives after D sends STOP_DONE. Keep its status/ACK
+	 * path alive without reopening any data-ring producer or trigger.
+	 */
+	ret = warp_checked_control_irq(warp, r->cookie != 0);
+	if (!ret) {
+		spin_lock_irqsave(&s->gate, flags);
+		s->control_irq = r->cookie != 0;
+		spin_unlock_irqrestore(&s->gate, flags);
+	}
+	warp_checked_release(r);
+	if (ret)
+		return ret;
+	return warp_checked_budget(r) < 0 ? warp_checked_budget(r) : 0;
+}
+
+static int warp_checked_irq_close(struct warp_entry *warp,
+				  struct mtk_warp_ser_request *r)
+{
+	struct warp_checked_state *s = &warp->wed.checked;
+	unsigned long flags;
+	int ret;
+	spin_lock_irqsave(&s->gate, flags);
+	s->control_irq = false;
+	spin_unlock_irqrestore(&s->gate, flags);
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		return ret;
+	if (!wait_event_timeout(s->drained, !READ_ONCE(s->active),
+				msecs_to_jiffies(ret)))
+		return -ETIMEDOUT;
+	return warp_checked_control_irq(warp, false);
+}
+
+int warp_ser_checked(void *owner, struct mtk_warp_ser_request *r)
+{
+	struct warp_entry *warp = warp_entry_get_by_privdata(owner);
+	struct warp_checked_state *s;
+	int ret = -ENODEV;
+	if (!r)
+		return -EINVAL;
+	if (!warp || !warp->wed.checked.initialized || !warp->wed.checked.probe_complete)
+		goto out;
+	s = &warp->wed.checked;
+	mutex_lock(&s->control);
+	if (s->error || mtk_cpu_profile_is_fatal()) {
+		ret = s->error ?: -EIO;
+		goto unlock;
+	}
+	ret = warp_checked_budget(r);
+	if (ret < 0)
+		goto failed;
+	if (r->phase == MTK_WARP_SER_QUIESCE) {
+		if (s->phase || !r->cookie) {
+			ret = -EBUSY;
+			goto failed;
+		}
+		s->cookie = r->cookie;
+		r->stop_proven = 0;
+		r->cleanup_done = 0;
+		ret = warp_checked_quiesce(warp, r);
+	} else if (r->cookie != s->cookie || r->phase != s->phase + 1) {
+		ret = -EPROTO;
+	} else switch (r->phase) {
+	case MTK_WARP_SER_STOP:
+		r->stop_proven = 0;
+		/* RESET_DONE has already been consumed. No later N9 event is
+		 * expected until the admitted RESUME publishes INIT_DONE.
+		 */
+		ret = warp_checked_irq_close(warp, r);
+		if (ret)
+			break;
+		ret = warp_checked_wo(warp, WO_STATE_SER_RESET, r);
+		if (!ret)
+			ret = warp_checked_hw_stop(warp, r);
+		if (!ret) {
+			r->stop_proven = 1;
+			s->quiescent = true;
+		}
+		break;
+	case MTK_WARP_SER_CLEANUP:
+		if (!r->stop_proven || r->cleanup_done) {
+			ret = -EPROTO;
+			break;
+		}
+		/* The old proof does not survive an intervening FE reset. */
+		r->stop_proven = 0;
+		s->quiescent = false;
+		ret = warp_checked_hw_stop(warp, r);
+		if (ret)
+			break;
+		r->stop_proven = 1;
+		s->quiescent = true;
+		ret = warp_checked_grant(r);
+		if (ret)
+			break;
+		ret = warp_checked_hw_reset(warp, r);
+		/* A reset completion failure cannot retain the earlier proof. */
+		r->stop_proven = 0;
+		s->quiescent = false;
+		if (!ret)
+			ret = warp_checked_hw_stop(warp, r);
+		if (!ret) {
+			r->stop_proven = 1;
+			s->quiescent = true;
+			ret = wed_tx_ring_reset(&warp->wed);
+		}
+		if (!ret)
+			ret = wdma_tx_ring_reset(&warp->wdma);
+		if (!ret)
+			ret = wed_rx_ring_reset(&warp->wed);
+		if (!ret) {
+			wed_rx_bm_exit(&warp->wed);
+			r->cleanup_done = 1;
+			s->resources = false;
+			s->exposed = false;
+		}
+		warp_checked_release(r);
+		break;
+	case MTK_WARP_SER_PREPARE:
+		if (!r->cleanup_done) {
+			ret = -EPROTO;
+			break;
+		}
+		ret = warp_checked_prepare(warp, r);
+		break;
+	case MTK_WARP_SER_RESUME:
+		ret = warp_checked_resume(warp, r);
+		break;
+	case MTK_WARP_SER_COMPLETE:
+		ret = warp_checked_budget(r);
+		if (ret >= 0) {
+			s->phase = 0;
+			s->cookie = 0;
+			ret = 0;
+		}
+		break;
+	default:
+		ret = -EPROTO;
+	}
+	if (!ret) {
+		if (r->phase != MTK_WARP_SER_COMPLETE)
+			s->phase = r->phase;
+		goto unlock;
+	}
+failed:
+	s->error = ret;
+	mtk_cpu_profile_note_fault(ret);
+unlock:
+	mutex_unlock(&s->control);
+out:
+	WRITE_ONCE(r->result, ret);
+	return ret;
+}
+EXPORT_SYMBOL(warp_ser_checked);
+
+/* Caller holds the complete global destructor permit, never a naked check. */
+void warp_checked_shutdown(struct warp_entry *warp)
+{
+	struct warp_checked_state *s = &warp->wed.checked;
+	struct mtk_warp_ser_request r = {
+		.deadline = jiffies + msecs_to_jiffies(3000),
+	};
+	int ret;
+	if (!s->initialized)
+		return;
+	mutex_lock(&s->control);
+	ret = warp_checked_quiesce(warp, &r);
+	/* Ordinary close keeps WO running while the stopped D HIF and WED
+	 * pipeline drain. Online SER has its own SER_RESET phase above.
+	 */
+	if (!ret && s->exposed && !s->quiescent)
+		ret = warp_checked_hw_stop(warp, &r);
+	if (ret) {
+		mutex_unlock(&s->control);
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_STOP_FAILED, ret);
+	}
+	s->quiescent = true;
+	mutex_unlock(&s->control);
+	/* Global destructor admission still spans this synchronous call. */
+	ret = woif_prepare_exit(warp);
+	if (ret)
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_STOP_FAILED, ret);
+}
+
+bool warp_checked_allow_enable(struct wed_entry *wed)
+{
+	struct warp_checked_state *s = &wed->checked;
+	return !mtk_cpu_profile_is_fatal() && !READ_ONCE(s->error) &&
+		(!READ_ONCE(s->stopping) ||
+		 READ_ONCE(s->enable_actor) == (unsigned long)current);
+}
