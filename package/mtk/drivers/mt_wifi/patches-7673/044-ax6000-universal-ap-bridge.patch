+#ifdef CONFIG_MTK_AP_BRIDGE
+/* Initialized-stage bits prevent both a partial-init call through NULL ops
+ * and a second exit after a WfInit-owned HIF error unwind. */
+int mtk_wifi_cpu_queues_stop(RTMP_ADAPTER *ad)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	int ret;
+	if (c->cpu_tm_live) {
+		ret = tm_exit(ad);
+		if (ret) return ret < 0 ? ret : -EIO;
+		c->cpu_tm_live = false;
+	}
+	if (c->cpu_qm_live) {
+		ret = qm_exit(ad);
+		if (ret) return ret < 0 ? ret : -EIO;
+		c->cpu_qm_live = false;
+	}
+	return 0;
+}
+
+static void mtk_wifi_cpu_init_abort(RTMP_ADAPTER *ad, bool wf_ready)
+{
+	ERR_RECOVERY_CTRL_T *c = &ad->ErrRecoveryCtl;
+	/* A completed WfInit has valid lower-layer ownership; stop it checked.
+ * An incomplete WfInit already unwound its initialized HIF itself. */
+	if (wf_ready && c->cpu_hif_live) {
+		chip_interrupt_disable(ad);
+		if (chip_set_hif_dma(ad, DMA_TX_RX, FALSE) != TRUE ||
+		    !chip_wait_hif_dma_idle(ad, ALL_DMA, 200, 1000))
+			mtk_cpu_dma_fatal(MTK_CPU_DMA_STOP_FAILED, -ETIMEDOUT);
+		c->cpu_hif_quiet = true;
+	} else if (!wf_ready && c->cpu_hif_live) {
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_PROOF_LOST, -EPROTO);
+	}
+	if (mtk_wifi_cpu_queues_stop(ad))
+		mtk_cpu_dma_fatal(MTK_CPU_DMA_STOP_FAILED, -EIO);
+	if (wf_ready) WfSysPosExit(ad);
+}
