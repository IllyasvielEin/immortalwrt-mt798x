+static int ccif_activate(struct woif_bus *bus)
+{
+	unsigned long flags;
+	if (!bus->hw || !bus->irq_requested || !bus->task_initialized)
+		return -ENODEV;
+	spin_lock_irqsave(&bus->state_lock, flags);
+	bus->stopping = false;
+	bus->ready = true;
+	warp_ccif_isr_ctrl(bus->hw, true);
+	spin_unlock_irqrestore(&bus->state_lock, flags);
+	return 0;
+}
+
+static void ccif_quiesce(struct woif_bus *bus)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&bus->state_lock, flags);
+	bus->stopping = true;
+	bus->ready = false;
+	if (bus->hw)
+		warp_ccif_isr_ctrl(bus->hw, false);
+	spin_unlock_irqrestore(&bus->state_lock, flags);
+	if (bus->irq_requested)
+		synchronize_irq(bus->irq);
 }
 
 
