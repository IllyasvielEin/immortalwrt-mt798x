+static int woif_checked_halt(struct warp_entry *warp)
+{
+	struct woif_entry *woif = &warp->woif;
+	struct warp_msg_cmd cmd = {0};
+	unsigned long deadline;
+	u8 state = WO_STATE_HALT;
+	u32 value;
+	int ret;
+
+	if (woif->wo_ctrl.cur_state != WO_STATE_ENABLE &&
+	    woif->wo_ctrl.cur_state != WO_STATE_SER_RESET)
+		return -EPROTO;
+	ret = warp_dummy_cr_set(&warp->wed, WED_DUMMY_CR_WO_STATUS, WOIF_UNDEFINED);
+	if (ret)
+		return -EIO;
+	ret = warp_dummy_cr_get(&warp->wed, WED_DUMMY_CR_WO_STATUS, &value);
+	if (ret || value != WOIF_UNDEFINED)
+		return -EIO;
+	cmd.param.cmd_id = WO_CMD_CHANGE_STATE;
+	cmd.param.to_id = MODULE_ID_WO;
+	cmd.param.wait_type = WARP_MSG_WAIT_TYPE_NONE;
+	cmd.param.timeout = 1000;
+	cmd.msg = &state;
+	cmd.msg_len = sizeof(state);
+	ret = warp_msg_send_cmd(warp->idx, &cmd);
+	if (ret != WARP_OK_STATUS)
+		return ret < 0 ? ret : -EREMOTEIO;
+	deadline = jiffies + WOCPU_TIMEOUT;
+	do {
+		ret = warp_dummy_cr_get(&warp->wed, WED_DUMMY_CR_WO_STATUS, &value);
+		if (ret)
