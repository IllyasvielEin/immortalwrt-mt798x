+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_MTK_CPU_LIFECYCLE_H
+#define _LINUX_MTK_CPU_LIFECYCLE_H
+
+/* Value-only state transitions. Callers serialize them with the FE lock. */
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#endif
+
+#define MTK_CPU_LIFE_TEARDOWN 1U
+#define MTK_CPU_LIFE_SER_CLEANUP 2U
+#define MTK_CPU_CLEANUP_FE 1U
+#define MTK_CPU_CLEANUP_WIFI 2U
+
+struct mtk_cpu_lifetime {
+	unsigned long long cookie;
+	unsigned int kind;
+	unsigned int reserved;
+};
+
+struct mtk_cpu_life_state {
+	unsigned long long sequence;
+	unsigned long fe_actor;
+	unsigned long wifi_actor;
+	const void *wifi_owner;
+	unsigned long teardown_actor;
+	unsigned int teardown_depth;
+	unsigned int cleanup;
+};
+
+static inline bool mtk_cpu_life_active(const struct mtk_cpu_life_state *s)
+{
+	return s->fe_actor || s->wifi_actor || s->teardown_depth;
+}
+
+static inline int mtk_cpu_life_next(struct mtk_cpu_life_state *s)
+{
+	if (s->sequence == ~0ULL)
+		return -EOVERFLOW;
+	s->sequence++;
+	return 0;
+}
+
+static inline int mtk_cpu_life_begin_fe(struct mtk_cpu_life_state *s,
+				       unsigned long actor,
+				       unsigned long long *cookie)
+{
+	int err;
+
+	if (!actor || !cookie)
+		return -EINVAL;
+	if (mtk_cpu_life_active(s))
+		return -EBUSY;
+	err = mtk_cpu_life_next(s);
+	if (err)
+		return err;
+	s->fe_actor = actor;
+	s->cleanup = 0;
+	*cookie = s->sequence;
+	return 0;
+}
+
+static inline int mtk_cpu_life_begin_wifi(struct mtk_cpu_life_state *s,
+					 const void *owner, unsigned long actor,
+					 unsigned long long join,
+					 unsigned long long *cookie)
+{
+	int err;
+
+	if (!owner || !actor || !cookie)
+		return -EINVAL;
+	if (s->teardown_depth || s->wifi_actor || actor == s->fe_actor)
+		return -EBUSY;
+	if (join) {
+		if (!s->fe_actor || join != s->sequence)
+			return -ESTALE;
+	} else {
+		if (s->fe_actor)
+			return -EBUSY;
+		err = mtk_cpu_life_next(s);
+		if (err)
+			return err;
+		s->cleanup = 0;
+	}
+	s->wifi_actor = actor;
+	s->wifi_owner = owner;
+	*cookie = s->sequence;
+	return 0;
+}
+
+static inline unsigned int mtk_cpu_life_actor(const struct mtk_cpu_life_state *s,
+					     unsigned long actor)
+{
+	if (actor && actor == s->fe_actor)
+		return MTK_CPU_CLEANUP_FE;
+	if (actor && actor == s->wifi_actor)
+		return MTK_CPU_CLEANUP_WIFI;
+	return 0;
+}
+
+static inline int mtk_cpu_life_cleanup(struct mtk_cpu_life_state *s,
+				      unsigned long actor,
+				      unsigned long long cookie, bool enter)
+{
+	unsigned int bit = mtk_cpu_life_actor(s, actor);
+
+	if (!bit || cookie != s->sequence)
+		return -ESTALE;
+	if (!!(s->cleanup & bit) == enter)
+		return -EALREADY;
+	if (enter)
+		s->cleanup |= bit;
+	else
+		s->cleanup &= ~bit;
+	return 0;
+}
+
+static inline int mtk_cpu_life_end_fe(struct mtk_cpu_life_state *s,
+				     unsigned long actor,
+				     unsigned long long cookie)
+{
+	if (!actor || s->fe_actor != actor || cookie != s->sequence)
+		return -ESTALE;
+	if (s->cleanup & MTK_CPU_CLEANUP_FE)
+		return -EBUSY;
+	s->fe_actor = 0;
+	return 0;
+}
+
+static inline int mtk_cpu_life_end_wifi(struct mtk_cpu_life_state *s,
+				       const void *owner, unsigned long actor,
+				       unsigned long long cookie)
+{
+	if (!actor || s->wifi_actor != actor || s->wifi_owner != owner ||
+	    cookie != s->sequence)
+		return -ESTALE;
+	if (s->cleanup & MTK_CPU_CLEANUP_WIFI)
+		return -EBUSY;
+	s->wifi_actor = 0;
+	s->wifi_owner = NULL;
+	return 0;
+}
+
+static inline int mtk_cpu_life_destruct_enter(struct mtk_cpu_life_state *s,
+					     unsigned long actor,
+					     struct mtk_cpu_lifetime *permit)
+{
+	unsigned int bit;
+	int err;
+
+	if (!actor || !permit)
+		return -EINVAL;
+	if (s->fe_actor || s->wifi_actor) {
+		bit = mtk_cpu_life_actor(s, actor);
+		if (!bit || !(s->cleanup & bit))
+			return -EBUSY;
+		permit->kind = MTK_CPU_LIFE_SER_CLEANUP;
+	} else {
+		if (s->teardown_depth && s->teardown_actor != actor)
+			return -EBUSY;
+		if (s->teardown_depth == ~0U)
+			return -EOVERFLOW;
+		if (!s->teardown_depth) {
+			err = mtk_cpu_life_next(s);
+			if (err)
+				return err;
+			s->teardown_actor = actor;
+		}
+		s->teardown_depth++;
+		permit->kind = MTK_CPU_LIFE_TEARDOWN;
+	}
+	permit->cookie = s->sequence;
+	permit->reserved = 0;
+	return 0;
+}
+
+static inline int mtk_cpu_life_destruct_exit(struct mtk_cpu_life_state *s,
+					    unsigned long actor,
+					    struct mtk_cpu_lifetime *permit)
+{
+	unsigned int bit;
+
+	if (!permit || !permit->kind || permit->cookie != s->sequence)
+		return -ESTALE;
+	if (permit->kind == MTK_CPU_LIFE_SER_CLEANUP) {
+		bit = mtk_cpu_life_actor(s, actor);
+		if (!bit || !(s->cleanup & bit))
+			return -EPERM;
+	} else if (permit->kind == MTK_CPU_LIFE_TEARDOWN) {
+		if (!s->teardown_depth || s->teardown_actor != actor)
+			return -EPERM;
+		if (!--s->teardown_depth)
+			s->teardown_actor = 0;
+	} else {
+		return -EINVAL;
+	}
+	permit->cookie = 0;
+	permit->kind = 0;
+	return 0;
+}
+
+#endif
