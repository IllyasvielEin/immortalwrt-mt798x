+struct net_device;
+struct sk_buff;
+struct mtk_ap_bridge_gate;
+/* Stack token: enter/exit encompass configuration reads and packet action.
+ * No RTNL or sleep is allowed while holding a reader. PREPARE may sleep.
+ */
+struct mtk_ap_bridge_reader {
+	struct mtk_ap_bridge_gate *gate;
+	u64 owner;
+	u64 lease;
+};
+struct mtk_ap_bridge_skb_ext {
+	u64 rx_owner, rx_lease;
+	u64 tx_owner, tx_lease;
+	u16 tx_domain, tx_vid;
+	u32 tx_flags;
+};
+struct mtk_ap_bridge_info {
+	struct net_device *port; /* borrowed, only within caller's RCU section */
+	struct net_device *bridge;
+	u32 policy;
+	bool bridged;
+};
+struct mtk_ap_bridge_policy {
+	u32 flags; /* MTK_AP_BRIDGE_NO_FORWARDING[_BTNBSSID] */
+	bool driver_ready;
+	bool supported_role;
+};
+/* create returns ERR_PTR on failure, pins dev, permanently sets netns_local; destroy requires all driver
+ * entry points/queues stopped, waits for admitted readers and RCU queries.
+ */
+struct mtk_ap_bridge_gate *mtk_ap_bridge_create(struct net_device *dev);
+void mtk_ap_bridge_destroy(struct mtk_ap_bridge_gate *gate);
+/* RTNL held. direct ndo_siocdevprivate callback passes original user data. */
+int mtk_ap_bridge_ioctl(struct mtk_ap_bridge_gate *gate, void __user *data,
+		       const struct mtk_ap_bridge_policy *policy);
+/* Synchronous revoke (process context, may sleep), also used before teardown.
+ * It does not require RTNL; caller serializes driver config writers.
+ */
+void mtk_ap_bridge_block(struct mtk_ap_bridge_gate *gate);
+/* Caller first publishes profile !ready and keeps it so until return.
+ * Drains admitted CPU readers without revoking configuration/queue leases. */
+void mtk_ap_bridge_profile_drain(struct mtk_ap_bridge_gate *gate);
+bool mtk_ap_bridge_is_blocked(const struct mtk_ap_bridge_gate *gate);
+/* Configuration writers require a locally revoked gate; a temporary SER
+ * profile pause does not revoke the committed configuration/lease. */
+bool mtk_ap_bridge_config_blocked(const struct mtk_ap_bridge_gate *gate);
+bool mtk_ap_bridge_enter(struct mtk_ap_bridge_gate *gate,
+			 struct mtk_ap_bridge_reader *reader);
+void mtk_ap_bridge_exit(struct mtk_ap_bridge_reader *reader);
+/* Existing nonzero stamp must match; never renews queued packet leases.
+ * rx=true is authenticated RX, false is TX. GFP_ATOMIC COW, false on OOM.
+ */
+bool mtk_ap_bridge_stamp(struct sk_buff *skb,
+			 const struct mtk_ap_bridge_reader *reader, bool rx);
+bool mtk_ap_bridge_validate(const struct sk_buff *skb,
+			    const struct mtk_ap_bridge_reader *reader, bool rx);
+bool mtk_ap_bridge_inherit(struct sk_buff *to, const struct sk_buff *from);
+/* TX admission on the original Ethernet frame, BEFORE any VLAN rewrite.
+ * Includes TX lease stamp; a previously stamped packet needs a valid saved
+ * domain and is never assigned a new one. Native 802.11 conversions inherit.
+ */
+bool mtk_ap_bridge_tx_domain_stamp(struct sk_buff *skb,
+				const struct mtk_ap_bridge_reader *reader);
+bool mtk_ap_bridge_tx_domain_validate(const struct sk_buff *skb,
+				   const struct mtk_ap_bridge_reader *reader);
+/* RCU held by caller, no sleeping. Resolve ingress base skb tags or actual
+ * VLAN port. Returns 0 on committed intent match, negative means drop.
