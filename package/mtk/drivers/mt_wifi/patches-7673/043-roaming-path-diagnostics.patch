--- /dev/null
+++ b/mt_wifi/embedded/include/roam_diag_parse.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Fixed headers only: never copy TCP options or application payload. */
+#ifndef MT_ROAM_DIAG_PARSE_H
+#define MT_ROAM_DIAG_PARSE_H
+
+struct mt_roam_diag_frame {
+	unsigned char src[6], dst[6], sip[4], dip[4], flags;
+	unsigned short sport, dport;
+	unsigned int seq, ack;
+};
+
+static inline unsigned short mt_roam_diag_be16(const unsigned char *p)
+{
+	return ((unsigned short)p[0] << 8) | p[1];
+}
+
+static inline unsigned int mt_roam_diag_be32(const unsigned char *p)
+{
+	return ((unsigned int)p[0] << 24) | ((unsigned int)p[1] << 16) |
+	       ((unsigned int)p[2] << 8) | p[3];
+}
+
+/* read() follows skb_copy_bits(): zero on success, nonzero on short input. */
+static inline int mt_roam_diag_decode(void *context, unsigned int length,
+	int (*read)(void *, unsigned int, void *, unsigned int),
+	unsigned short port, struct mt_roam_diag_frame *frame)
+{
+	unsigned char eth[14], ip[20], tcp[20];
+	unsigned int ihl, i;
+
+	if (length < 54 || read(context, 0, eth, sizeof(eth)))
+		return 0;
+	/* This diagnostic intentionally covers untagged IPv4 only. */
+	if (mt_roam_diag_be16(eth + 12) != 0x0800 ||
+	    read(context, 14, ip, sizeof(ip)))
+		return 0;
+	ihl = (ip[0] & 15) * 4;
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != 6 ||
+	    (mt_roam_diag_be16(ip + 6) & 0x3fff) ||
+	    mt_roam_diag_be16(ip + 2) < ihl + 20 ||
+	    length < 14 + ihl + 20 ||
+	    read(context, 14 + ihl, tcp, sizeof(tcp)))
+		return 0;
+	if ((tcp[12] >> 4) < 5 ||
+	    mt_roam_diag_be16(ip + 2) < ihl + (unsigned int)(tcp[12] >> 4) * 4 ||
+	    length < 14 + ihl + (unsigned int)(tcp[12] >> 4) * 4 ||
+	    !(tcp[13] & 0x06) ||
+	    (mt_roam_diag_be16(tcp) != port &&
+	     mt_roam_diag_be16(tcp + 2) != port))
+		return 0;
+
+	for (i = 0; i < 6; i++) {
+		frame->dst[i] = eth[i];
+		frame->src[i] = eth[i + 6];
+	}
+	for (i = 0; i < 4; i++) {
+		frame->sip[i] = ip[12 + i];
+		frame->dip[i] = ip[16 + i];
+	}
+	frame->sport = mt_roam_diag_be16(tcp);
+	frame->dport = mt_roam_diag_be16(tcp + 2);
+	frame->seq = mt_roam_diag_be32(tcp + 4);
+	frame->ack = mt_roam_diag_be32(tcp + 8);
+	frame->flags = tcp[13];
+	return 1;
+}
+#endif
