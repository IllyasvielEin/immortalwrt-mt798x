+/* This is the MT7986 vendor per-WO reset, not the zero-mask whole-chip
+ * pulse in regs/reg_v2/warp_mt7986.c.  CPU_RSTB is active LOW (coda
+ * reg_v2/wox_mcu_cfg_ls.h): clear holds reset, set releases it.
+ * HALT_DONE must precede assertion when DMA resources were exposed;
+ * reset readback alone is not a hardware DMA-idle proof.
+ */
+#ifdef CONFIG_MTK_AP_BRIDGE
+#define WOIF_MT7986_RESET_PA 0x15194050
+#define WOIF_MT7986_WO0_RESET BIT(5)
+#define WOIF_MT7986_WO1_RESET BIT(0)
+static DEFINE_MUTEX(woif_reset_lock);
+
+static int woif_reset_control(struct woif_entry *woif, bool hold, bool write)
+{
+	void __iomem *reg;
+	u32 mask, value;
+	int ret = 0;
+
+	if (woif->idx > 1)
+		return -EINVAL;
+	mask = woif->idx ? WOIF_MT7986_WO1_RESET : WOIF_MT7986_WO0_RESET;
+	mutex_lock(&woif_reset_lock);
+	reg = ioremap(WOIF_MT7986_RESET_PA, sizeof(u32));
+	if (!reg) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	value = readl(reg);
+	if (write) {
+		value = hold ? value & ~mask : value | mask;
+		writel(value, reg);
+	}
+	value = readl(reg);
+	if (!!(value & mask) == hold)
+		ret = -EIO;
+	else
+		woif->reset_held = hold;
+	iounmap(reg);
+out:
+	mutex_unlock(&woif_reset_lock);
+	return ret;
+}
