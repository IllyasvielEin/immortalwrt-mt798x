+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include "netifd.h"
+#include "device.h"
+#include "mtk_ap_bridge.h"
+
+struct ap_bridge_state {
+	uint64_t owner, transaction;
+	unsigned int ifindex;
+	bool prepared, controlled, committed;
+	bool reload_touched, reload_pending;
+	struct device *dev;
+	struct uloop_timeout retry;
+	int error;
+};
+
+/* A network reload mutates several bridges/VLANs synchronously. Automatic
+ * COMMIT is permitted only after the entire batch has completed. */
+static bool ap_reload_active;
+static int ap_reload_error;
+
+void ap_bridge_config_error(int error)
+{
+	if (ap_reload_active && error && !ap_reload_error)
+		ap_reload_error = error < 0 ? error : -EIO;
+}
+
+static bool cpu_profile(void)
+{
+	char mode[16] = {0};
+	int fd = open("/usr/share/ax6000/forwarding-mode", O_RDONLY | O_CLOEXEC);
+	ssize_t n;
+	if (fd < 0)
+		return false;
+	n = read(fd, mode, sizeof(mode) - 1);
+	close(fd);
+	return n == 9 && !memcmp(mode, "cpu-only\n", 9);
+}
+
+struct device *ap_bridge_owner(struct device *dev)
+{
+	unsigned int depth = 0;
+	while (dev && dev->wireless_parent && depth++ < 16)
+		dev = dev->wireless_parent;
+	return dev && (dev->wireless_bridge_forwarding || dev->ap_bridge) ? dev : NULL;
+}
+
+static int ap_ioctl(struct device *dev, struct mtk_ap_bridge_request *r)
+{
+	struct ifreq ifr = {0};
+	int fd, ret;
+	r->abi = MTK_AP_BRIDGE_ABI;
+	r->size = sizeof(*r);
+	r->ifindex = if_nametoindex(dev->ifname);
+	if (!r->ifindex)
+		return -ENODEV;
+	strncpy(ifr.ifr_name, dev->ifname, sizeof(ifr.ifr_name) - 1);
+	ifr.ifr_data = (void *)r;
+	fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -errno;
+	ret = ioctl(fd, MTK_AP_BRIDGE_IOCTL, &ifr);
+	ret = ret < 0 ? -errno : r->error;
+	close(fd);
+	if (ret)
+		return ret < 0 ? ret : -ret;
+	if (r->abi != MTK_AP_BRIDGE_ABI || r->size != sizeof(*r) ||
+	    r->ifindex != if_nametoindex(dev->ifname))
+		return -EPROTO;
+	return 0;
+}
+
+/* A failed syscall may have committed before its outer copyout failed.
+ * Only a NEW successful PREPARE is evidence permitting relationship cleanup. */
+static int ap_confirm_block(struct device *dev, bool reuse)
+{
+	struct ap_bridge_state *s = dev->ap_bridge;
+	struct mtk_ap_bridge_request r = { .op = MTK_AP_BRIDGE_GET };
+	int ret = ap_ioctl(dev, &r);
+	if (ret)
+		goto fail;
+	if (reuse && s->prepared && r.blocked && r.owner == s->owner &&
+	    r.transaction == s->transaction)
+		return 0;
+	s->prepared = false;
+	s->owner = r.owner;
+	memset(&r, 0, sizeof(r));
+	r.op = MTK_AP_BRIDGE_PREPARE;
+	r.owner = s->owner;
+	ret = ap_ioctl(dev, &r);
+	if (ret || !r.blocked || r.state != MTK_AP_BRIDGE_BLOCKED ||
+	    r.owner != s->owner || !r.transaction) {
+		if (!ret)
+			ret = -EPROTO;
+		goto fail;
+	}
+	s->transaction = r.transaction;
+	s->ifindex = r.ifindex;
+	s->prepared = true;
+	s->error = 0;
+	return 0;
+fail:
+	s->prepared = false;
+	s->error = ret;
+	return ret;
+}
+
+int ap_bridge_prepare(struct device *dev)
+{
+	struct device *owner = ap_bridge_owner(dev);
+	int ret;
+	if (!cpu_profile() || !owner)
+		return 0;
+	if (!owner->ap_bridge) {
+		owner->ap_bridge = calloc(1, sizeof(*owner->ap_bridge));
+		if (!owner->ap_bridge)
+			return -ENOMEM;
+	}
+	owner->ap_bridge->dev = owner;
+	if (ap_reload_active && owner->ap_bridge->committed &&
+	    !owner->ap_bridge->controlled && !owner->ap_bridge->reload_touched) {
+		/* A corrected reload is a fresh attempt, never an old staged snapshot. */
+		owner->ap_bridge->reload_touched = true;
+		owner->ap_bridge->reload_pending = true;
+		owner->ap_bridge->prepared = false;
+		owner->ap_bridge->error = 0;
+		uloop_timeout_cancel(&owner->ap_bridge->retry);
+	}
+	if (owner->ap_bridge->prepared &&
+	    (!if_nametoindex(owner->ifname) ||
+	     owner->ap_bridge->ifindex == if_nametoindex(owner->ifname)))
+		return 0; /* No COMMIT since the positive blocked ACK in this process. */
+	ret = ap_confirm_block(owner, true);
+	/* Recover from an ambiguous negative result with GET + fresh PREPARE. */
+	if (ret)
+		ret = ap_confirm_block(owner, false);
+	ap_bridge_config_error(ret);
+	return ret;
+}
+
+struct ap_collect {
+	struct device *owner;
+	struct mtk_ap_bridge_domain d[MTK_AP_BRIDGE_MAX_DOMAINS];
+	unsigned int count;
+	int error;
+};
+
+static void ap_collect_domain(struct device *dev, void *arg)
+{
+	struct ap_collect *c = arg;
+	struct mtk_ap_bridge_domain *d;
+	struct device *p = dev;
+	unsigned int depth = 0, i;
+	struct mtk_ap_bridge_tag reverse[MTK_AP_BRIDGE_MAX_TAGS];
+	int ret;
+	if ((dev == c->owner && c->count) || c->error || ap_bridge_owner(dev) != c->owner ||
+	    (dev != c->owner && (!dev->present || !if_nametoindex(dev->ifname))))
+		return;
+	if (c->count == MTK_AP_BRIDGE_MAX_DOMAINS) {
+		c->error = -E2BIG;
+		return;
+	}
+	d = &c->d[c->count];
+	d->port_ifindex = if_nametoindex(dev->ifname);
+	if (!d->port_ifindex) {
+		c->error = -ENODEV;
+		return;
+	}
+	while (p != c->owner) {
+		if (!p->wireless_parent || depth == MTK_AP_BRIDGE_MAX_TAGS ||
+		    !p->wireless_vlan_proto) {
+			c->error = -EOPNOTSUPP;
+			return;
+		}
+		reverse[depth].ifindex = if_nametoindex(p->ifname);
+		reverse[depth].proto = p->wireless_vlan_proto;
+		reverse[depth++].vid = p->wireless_vlan_id;
+		p = p->wireless_parent;
+	}
+	d->depth = depth;
+	for (i = 0; i < depth; i++)
+		d->tag[i] = reverse[depth - i - 1];
+	d->policy = c->owner->wireless_policy;
+	ret = bridge_ap_expected(dev, d);
+	if (ret) {
+		c->error = ret;
+		return;
+	}
+	c->count++;
+}
+
+int ap_bridge_commit(struct device *dev)
+{
+	struct device *owner = ap_bridge_owner(dev);
+	struct ap_bridge_state *s;
+	struct ap_collect *c;
+	struct mtk_ap_bridge_request r;
+	unsigned int i, count;
+	int ret;
+	if (!cpu_profile() || !owner)
+		return 0;
+	s = owner->ap_bridge;
+	if (s && s->error) return s->error;
+	if (!s || !s->prepared)
+		return -EACCES;
+	c = calloc(1, sizeof(*c));
+	if (!c)
+		return -ENOMEM;
+	c->owner = owner;
+	ap_collect_domain(owner, c); /* ABI entry zero is always the base. */
+	device_foreach(ap_collect_domain, c);
+	ret = c->error;
+	count = c->count;
+	for (i = 0; !ret && i < c->count; i++) {
+		memset(&r, 0, sizeof(r));
+		r.op = MTK_AP_BRIDGE_STAGE_DOMAIN;
+		r.owner = s->owner;
+		r.transaction = s->transaction;
+		r.domain_count = c->count;
+		r.domain_index = i;
+		r.domain = c->d[i];
+		ret = ap_ioctl(owner, &r);
+	}
+	free(c);
+	if (!ret) {
+		memset(&r, 0, sizeof(r));
+		r.op = MTK_AP_BRIDGE_COMMIT;
+		r.domain_count = count;
+		r.owner = s->owner;
+		r.transaction = s->transaction;
+		ret = ap_ioctl(owner, &r);
+		if (!ret && (r.state != MTK_AP_BRIDGE_READY || r.blocked ||
+		    !r.driver_ready || !r.profile_ready || !r.lease))
+			ret = -EPROTO;
+	}
+	s->prepared = false;
+	if (!ret) {
+		s->committed = true; s->controlled = false;
+		s->reload_pending = false;
+	}
+	if (ret) {
+		int blocked = ap_confirm_block(owner, false);
+		if (blocked)
+			return blocked;
+		s->error = ret;
+	}
+	return ret;
+}
+
+void ap_bridge_free(struct device *dev)
+{
+	if (dev->ap_bridge) uloop_timeout_cancel(&dev->ap_bridge->retry);
+	free(dev->ap_bridge);
+	dev->ap_bridge = NULL;
+}
+
+uint64_t ap_bridge_port_flags(struct device *bridge, struct device *dev)
+{
+	bool mc = dev->wireless_ap;
+	uint64_t flags = (1ULL << 5) | (1ULL << 6) | (1ULL << 11) | (1ULL << 14);
+	if (dev->wireless_multicast_set)
+		mc = dev->wireless_multicast;
+	else if (dev->settings.flags & DEV_OPT_MULTICAST_TO_UNICAST)
+		mc = dev->settings.multicast_to_unicast;
+	else if ((bridge->settings.flags & DEV_OPT_MULTICAST_TO_UNICAST) &&
+		 !bridge->settings.multicast_to_unicast)
+		mc = false;
+	if ((dev->wireless_bridge_forwarding || mc || dev->wireless_proxyarp) &&
+	    !dev->wireless_isolate)
+		flags |= 1ULL;
+	if (mc) flags |= 1ULL << 12;
+	if (dev->wireless_proxyarp) flags |= 1ULL << 10;
+	if (dev->wireless_bridge_isolate ||
+	    ((dev->settings.flags & DEV_OPT_ISOLATE) && dev->settings.isolate))
+		flags |= 1ULL << 16;
+	if (dev->bpdu_filter) flags |= 1ULL << 24;
+	if ((dev->settings.flags & DEV_OPT_LEARNING) && !dev->settings.learning)
+		flags &= ~(1ULL << 5);
+	if ((dev->settings.flags & DEV_OPT_UNICAST_FLOOD) && !dev->settings.unicast_flood)
+		flags &= ~(1ULL << 6);
+	return flags;
+}
+
+int ap_bridge_prepare_new(struct device *dev)
+{
+	struct device *owner = ap_bridge_owner(dev);
+	int ret;
+	if (owner && owner->ap_bridge) {
+		owner->ap_bridge->prepared = false;
+		owner->ap_bridge->error = 0;
+	}
+	ret = ap_bridge_prepare(dev);
+	if (owner && owner->ap_bridge)
+		owner->ap_bridge->controlled = true;
+	return ret;
+}
+
+void ap_bridge_fault(struct device *dev, int error)
+{
+	struct device *owner = ap_bridge_owner(dev);
+	ap_bridge_config_error(error);
+	if (error && owner && owner->ap_bridge)
+		owner->ap_bridge->error = error < 0 ? error : -EIO;
+}
+
+static void ap_retry(struct uloop_timeout *t)
+{
+	struct ap_bridge_state *s = container_of(t, struct ap_bridge_state, retry);
+	if (ap_reload_active || s->controlled || !s->committed ||
+	    (s->reload_pending && s->error)) return;
+	/* New complete attempt, never reuse a failed staged snapshot. */
+	s->prepared = false;
+	s->error = 0;
+	if (!ap_bridge_prepare(s->dev))
+		ap_bridge_commit(s->dev);
+}
+
+void ap_bridge_reconcile(struct device *dev)
+{
+	struct device *owner = ap_bridge_owner(dev);
+	if (!ap_reload_active && owner && owner->ap_bridge &&
+	    owner->ap_bridge->committed && !owner->ap_bridge->controlled &&
+	    !(owner->ap_bridge->reload_pending && owner->ap_bridge->error)) {
+		owner->ap_bridge->retry.cb = ap_retry;
+		uloop_timeout_set(&owner->ap_bridge->retry, 10);
+	}
+}
+
+static void ap_reload_begin_owner(struct device *dev, void *arg)
+{
+	(void)arg;
+	if (dev->ap_bridge)
+		dev->ap_bridge->reload_touched = false;
+}
+
+void ap_bridge_config_begin(void)
+{
+	ap_reload_active = cpu_profile();
+	ap_reload_error = 0;
+	if (ap_reload_active)
+		device_foreach(ap_reload_begin_owner, NULL);
+}
+
+static void ap_reload_finish_owner(struct device *dev, void *arg)
+{
+	struct ap_bridge_state *s = dev->ap_bridge;
+	(void)arg;
+	if (!s || !s->reload_touched || s->controlled || !s->committed)
+		return;
+	if (ap_reload_error && !s->error)
+		s->error = ap_reload_error;
+	if (!s->error)
+		ap_bridge_reconcile(dev);
+}
+
+int ap_bridge_config_end(void)
+{
+	bool active = ap_reload_active;
+	ap_reload_active = false;
+	if (active)
+		device_foreach(ap_reload_finish_owner, NULL);
+	return ap_reload_error;
+}
