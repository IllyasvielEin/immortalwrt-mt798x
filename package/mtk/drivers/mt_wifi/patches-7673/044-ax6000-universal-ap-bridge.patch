+	if (r->phase == MTK_WARP_SER_STOP) r->stop_proven = 1;
+	if (r->phase == MTK_WARP_SER_CLEANUP) {
+		if (!r->stop_proven || r->cleanup_done) {
+			cmpxchg(&r->permission, 1, 0);
+			return -EPROTO;
