+/* SPDX-License-Identifier: GPL-2.0 */
+#include "rt_config.h"
+#include <linux/mtk_cpu_profile.h>
+#include <linux/mutex.h>
+#include <linux/capability.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/rtnetlink.h>
+#include <linux/slab.h>
+#include <net/net_namespace.h>
+
+struct mtk_ap_adapter {
+	struct mutex config;
+	struct net *net;
+	struct nf_hook_ops hooks[2];
+	bool stopping;
+};
+
+bool mtk_ap_plain_ap(const struct wifi_dev *wdev)
+{
+	return wdev && wdev->wdev_type == WDEV_TYPE_AP;
+}
+
+static bool mtk_ap_role_supported(RTMP_ADAPTER *ad, struct wifi_dev *wdev)
+{
+	if (!mtk_ap_plain_ap(wdev) || !wdev->ap_bridge_gate ||
+	    !VALID_MBSS(ad, wdev->func_idx) ||
+	    wdev != &ad->ApCfg.MBSSID[wdev->func_idx].wdev)
+		return false;
+#ifdef MWDS
+	if (wdev->bSupportMWDS)
+		return false;
+#endif
+#ifdef CONFIG_MAP_SUPPORT
+	if (wdev->MAPCfg.DevOwnRole & BIT(MAP_ROLE_BACKHAUL_BSS))
+		return false;
+#endif
+#ifdef MAP_TS_TRAFFIC_SUPPORT
+	if (ad->bTSEnable)
+		return false;
+#endif
+#ifdef DYNAMIC_VLAN_SUPPORT
+	if (!ad->CommonCfg.bDynamicVlanDisabled)
+		return false;
+#endif
+#ifdef MBSS_AS_WDS_AP_SUPPORT
+	if (wdev->wds_enable)
+		return false;
+#endif
+#ifdef CONFIG_VLAN_GTK_SUPPORT
+	if (!list_empty(&wdev->vlan_gtk_list))
+		return false;
+#endif
+	return true;
+}
+
+/* WdevListLock protects membership and each gate pointer. The callback never
+ * retains a wdev, acquires RTNL, or looks up a destination wireless station.
+ */
+static int mtk_ap_match_locked(RTMP_ADAPTER *ad, const struct net_device *dev,
+			       const struct sk_buff *skb, bool ingress,
+			       unsigned int *bss, u32 *policy)
+{
+	unsigned int i;
+	if (!dev)
+		return 0;
+	for (i = 0; i < WDEV_NUM_MAX; i++) {
+		struct wifi_dev *wdev = ad->wdev_list[i];
+		struct mtk_ap_bridge_info info;
+		struct mtk_ap_bridge_reader reader = { 0 };
+		int ret;
+		if (!mtk_ap_plain_ap(wdev) || !wdev->ap_bridge_gate)
+			continue;
+		ret = mtk_ap_bridge_match_rcu(wdev->ap_bridge_gate, dev, skb, &info);
+		if (!ret)
+			continue;
+		if (ret < 0 || !mtk_ap_bridge_enter(wdev->ap_bridge_gate, &reader))
+			return -1;
+		if (ingress && !mtk_ap_bridge_validate(skb, &reader, true))
+			ret = -1;
+		if (!mtk_ap_role_supported(ad, wdev))
+			ret = -1;
+		mtk_ap_bridge_exit(&reader);
+		if (ret < 0)
+			return -1;
+		*bss = wdev->func_idx;
+		*policy = info.policy;
+		return 1;
+	}
+	return 0;
+}
+
+static unsigned int mtk_ap_bridge_hook(void *priv, struct sk_buff *skb,
+				      const struct nf_hook_state *state)
+{
+	RTMP_ADAPTER *ad = priv;
+	unsigned int in_bss = 0, out_bss = 0;
+	u32 in_policy = 0, out_policy = 0;
+	int in, out = 0;
+	bool drop = false;
+
+	rcu_read_lock();
+	NdisAcquireSpinLock(&ad->WdevListLock);
+	in = mtk_ap_match_locked(ad, state->in, skb, true, &in_bss, &in_policy);
+	if (in < 0)
+		drop = true;
+	if (state->hook == NF_BR_FORWARD) {
+		out = mtk_ap_match_locked(ad, state->out, skb, false,
+					 &out_bss, &out_policy);
+		drop |= apbr_isolation_denies(in, out, in_bss == out_bss,
+			in_policy & MTK_AP_BRIDGE_NO_FORWARDING,
+			(in_policy | out_policy) & MTK_AP_BRIDGE_NO_FORWARDING_BTNBSSID);
+	}
+	NdisReleaseSpinLock(&ad->WdevListLock);
+	rcu_read_unlock();
+	return drop ? NF_DROP : NF_ACCEPT;
+}
+
+int mtk_ap_adapter_init(RTMP_ADAPTER *ad, PNET_DEV dev)
+{
+	struct mtk_ap_adapter *ctx;
+	int ret;
+	if (ad->ap_bridge)
+		return 0;
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	mutex_init(&ctx->config);
+	ctx->net = get_net(dev_net(dev));
+	ctx->hooks[0].hook = mtk_ap_bridge_hook;
+	ctx->hooks[0].priv = ad;
+	ctx->hooks[0].pf = NFPROTO_BRIDGE;
+	ctx->hooks[0].hooknum = NF_BR_PRE_ROUTING;
+	ctx->hooks[0].priority = NF_BR_PRI_FIRST;
+	ctx->hooks[1] = ctx->hooks[0];
+	ctx->hooks[1].hooknum = NF_BR_FORWARD;
+	ret = nf_register_net_hook(ctx->net, &ctx->hooks[0]);
+	if (ret)
+		goto free;
+	ret = nf_register_net_hook(ctx->net, &ctx->hooks[1]);
+	if (ret) {
+		nf_unregister_net_hook(ctx->net, &ctx->hooks[0]);
+		synchronize_net();
+		goto free;
+	}
+	WRITE_ONCE(ad->ap_bridge, ctx);
+	return 0;
+free:
+	put_net(ctx->net);
+	kfree(ctx);
+	return ret;
+}
+
+/* Process-context callers have stopped wdev create/delete before adapter
+ * teardown/SER. Never sleep while holding WdevListLock or an RX reader.
+ */
+static void mtk_ap_drain_all(RTMP_ADAPTER *ad, bool profile_only)
+{
+	unsigned int i;
+	for (i = 0; i < WDEV_NUM_MAX; i++) {
+		struct wifi_dev *wdev = ad->wdev_list[i];
+		if (!wdev || !wdev->ap_bridge_gate)
+			continue;
+		if (profile_only)
+			mtk_ap_bridge_profile_drain(wdev->ap_bridge_gate);
+		else
+			mtk_ap_bridge_block(wdev->ap_bridge_gate);
+	}
+}
+
+void mtk_ap_adapter_block(RTMP_ADAPTER *ad)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	if (!ctx)
+		return;
+	mutex_lock(&ctx->config);
+	mtk_ap_drain_all(ad, false);
+	mutex_unlock(&ctx->config);
+}
+
+void mtk_ap_adapter_ser_drain(RTMP_ADAPTER *ad)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	if (!ctx)
+		return;
+	mutex_lock(&ctx->config);
+	mtk_ap_drain_all(ad, true);
+	mutex_unlock(&ctx->config);
+}
+
+void mtk_ap_adapter_exit(RTMP_ADAPTER *ad)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	unsigned int i;
+	if (!ctx)
+		return;
+	mutex_lock(&ctx->config);
+	ctx->stopping = true;
+	mtk_ap_drain_all(ad, false);
+	/* All driver entry points and wdev create/delete are stopped. This also
+	 * covers a main wdev whose OS attach failed before normal deinit ran.
+	 * Its netdev is still alive: the caller must exit before free_netdev.
+	 */
+	for (i = 0; i < WDEV_NUM_MAX; i++) {
+		struct wifi_dev *wdev;
+		struct mtk_ap_bridge_gate *gate = NULL;
+		NdisAcquireSpinLock(&ad->WdevListLock);
+		wdev = ad->wdev_list[i];
+		if (wdev) {
+			gate = wdev->ap_bridge_gate;
+			WRITE_ONCE(wdev->ap_bridge_gate, NULL);
+		}
+		NdisReleaseSpinLock(&ad->WdevListLock);
+		if (gate)
+			mtk_ap_bridge_destroy(gate);
+	}
+	mutex_unlock(&ctx->config);
+	nf_unregister_net_hook(ctx->net, &ctx->hooks[1]);
+	nf_unregister_net_hook(ctx->net, &ctx->hooks[0]);
+	synchronize_net();
+	WRITE_ONCE(ad->ap_bridge, NULL);
+	put_net(ctx->net);
+	kfree(ctx);
+}
+
+int mtk_ap_wdev_init(RTMP_ADAPTER *ad, struct wifi_dev *wdev)
+{
+	struct mtk_ap_bridge_gate *gate;
+	if (!mtk_ap_plain_ap(wdev) || wdev->ap_bridge_gate)
+		return 0;
+	if (!wdev->if_dev)
+		return -ENODEV;
+	gate = mtk_ap_bridge_create(wdev->if_dev);
+	if (IS_ERR(gate))
+		return PTR_ERR(gate);
+	WRITE_ONCE(wdev->ap_bridge_gate, gate);
+	return 0;
+}
+
+void mtk_ap_wdev_exit(RTMP_ADAPTER *ad, struct wifi_dev *wdev)
+{
+	struct mtk_ap_bridge_gate *gate = wdev->ap_bridge_gate;
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	if (!gate)
+		return;
+	if (ctx)
+		mutex_lock(&ctx->config);
+	/* Caller has removed wdev from WdevListLock-protected registry. */
+	WRITE_ONCE(wdev->ap_bridge_gate, NULL);
+	mtk_ap_bridge_destroy(gate);
+	if (ctx)
+		mutex_unlock(&ctx->config);
+}
+
+void mtk_ap_wdev_block(RTMP_ADAPTER *ad, struct wifi_dev *wdev)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	if (ctx)
+		mutex_lock(&ctx->config);
+	if (wdev && wdev->ap_bridge_gate)
+		mtk_ap_bridge_block(wdev->ap_bridge_gate);
+	if (ctx)
+		mutex_unlock(&ctx->config);
+}
+
+void mtk_ap_netdev_block(PNET_DEV dev)
+{
+	RTMP_ADAPTER *ad = RTMP_OS_NETDEV_GET_PRIV(dev);
+	struct wifi_dev *wdev = RTMP_OS_NETDEV_GET_WDEV(dev);
+	if (ad && wdev)
+		mtk_ap_wdev_block(ad, wdev);
+}
+
+bool mtk_ap_config_enter(RTMP_ADAPTER *ad, struct wifi_dev *wdev)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	unsigned int i;
+	if (!ctx)
+		return true; /* Before publication, every gate is still BLOCKED. */
+	mutex_lock(&ctx->config);
+	if (ctx->stopping)
+		goto busy;
+	if (wdev) {
+		if (wdev->ap_bridge_gate &&
+		    !mtk_ap_bridge_config_blocked(wdev->ap_bridge_gate))
+			goto busy;
+	} else {
+		for (i = 0; i < WDEV_NUM_MAX; i++) {
+			wdev = ad->wdev_list[i];
+			if (wdev && wdev->ap_bridge_gate &&
+			    !mtk_ap_bridge_config_blocked(wdev->ap_bridge_gate))
+				goto busy;
+		}
+	}
+	return true;
+busy:
+	mutex_unlock(&ctx->config);
+	return false;
+}
+
+void mtk_ap_config_exit(RTMP_ADAPTER *ad)
+{
+	struct mtk_ap_adapter *ctx = READ_ONCE(ad->ap_bridge);
+	if (ctx)
+		mutex_unlock(&ctx->config);
+}
+
+int mtk_ap_private_ioctl(struct net_device *dev, struct ifreq *ifr,
+			 void __user *data, int cmd)
+{
+	RTMP_ADAPTER *ad = RTMP_OS_NETDEV_GET_PRIV(dev);
+	struct wifi_dev *wdev = RTMP_OS_NETDEV_GET_WDEV(dev);
+	struct mtk_ap_bridge_policy policy = { 0 };
+	struct mtk_ap_adapter *ctx;
+	int ret;
+	if (cmd != MTK_AP_BRIDGE_IOCTL)
+		return dev->netdev_ops->ndo_do_ioctl ?
+			dev->netdev_ops->ndo_do_ioctl(dev, ifr, cmd) : -EOPNOTSUPP;
+	ASSERT_RTNL();
+	if (!ad || !mtk_ap_plain_ap(wdev) || !wdev->ap_bridge_gate)
+		return -EOPNOTSUPP;
+	if (!ns_capable(dev_net(dev)->user_ns, CAP_NET_ADMIN))
+		return -EPERM;
+	ctx = READ_ONCE(ad->ap_bridge);
+	if (!ctx || !net_eq(ctx->net, dev_net(dev)))
+		return -ENODEV;
+	mutex_lock(&ctx->config);
+	policy.supported_role = !ctx->stopping && mtk_ap_role_supported(ad, wdev);
+	policy.driver_ready = policy.supported_role &&
+		RTMP_TEST_FLAG(ad, fRTMP_ADAPTER_SYSEM_READY) &&
+		READ_ONCE(wdev->if_up_down_state);
+	if (VALID_MBSS(ad, wdev->func_idx) &&
+	    READ_ONCE(ad->ApCfg.MBSSID[wdev->func_idx].IsolateInterStaTraffic))
+		policy.flags |= MTK_AP_BRIDGE_NO_FORWARDING;
+	if (READ_ONCE(ad->ApCfg.IsolateInterStaTrafficBTNBSSID))
+		policy.flags |= MTK_AP_BRIDGE_NO_FORWARDING_BTNBSSID;
+	ret = mtk_ap_bridge_ioctl(wdev->ap_bridge_gate, data, &policy);
+	mutex_unlock(&ctx->config);
+	return ret;
+}
+
+bool mtk_ap_rx_early_enter(RTMP_ADAPTER *ad, RX_BLK *rx,
+			   struct wifi_dev *wdev)
+{
+	memset(&rx->ap_bridge_reader, 0, sizeof(rx->ap_bridge_reader));
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	if (!mtk_ap_bridge_enter(wdev->ap_bridge_gate, &rx->ap_bridge_reader))
+		return false;
+	if (!mtk_ap_role_supported(ad, wdev)) {
+		mtk_ap_bridge_exit(&rx->ap_bridge_reader);
+		return false;
+	}
+	return true;
+}
+
+void mtk_ap_rx_early_exit(RX_BLK *rx)
+{
+	mtk_ap_bridge_exit(&rx->ap_bridge_reader);
+}
+
+bool mtk_ap_rx_late_enter(RTMP_ADAPTER *ad, struct wifi_dev *wdev,
+			 PNDIS_PACKET pkt, struct mtk_ap_bridge_reader *reader)
+{
+	memset(reader, 0, sizeof(*reader));
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	if (!mtk_ap_bridge_enter(wdev->ap_bridge_gate, reader))
+		return false;
+	if (!mtk_ap_role_supported(ad, wdev) ||
+	    !mtk_ap_bridge_validate(RTPKT_TO_OSPKT(pkt), reader, true)) {
+		mtk_ap_bridge_exit(reader);
+		return false;
+	}
+	return true;
+}
+
+int mtk_ap_rx_authorize(RTMP_ADAPTER *ad, MAC_TABLE_ENTRY *peer, RX_BLK *rx,
+			struct wifi_dev *wdev, const UCHAR *data,
+			unsigned int length, bool ethernet)
+{
+	struct apbr_wire_view view;
+	enum apbr_wire_kind kind;
+	STA_TR_ENTRY *tr;
+	FRAME_CONTROL *fc = (FRAME_CONTROL *)rx->FC;
+	if (!mtk_ap_plain_ap(wdev))
+		return 0;
+	if (!peer || !VALID_UCAST_ENTRY_WCID(ad, peer->wcid) ||
+	    peer->wdev != wdev || !IS_ENTRY_CLIENT(peer) ||
+	    peer->Sst != SST_ASSOC)
+		return -1;
+	if (!fc || fc->Type != FC_TYPE_DATA || !fc->ToDs || fc->FrDs)
+		return -1;
+#ifdef A4_CONN
+	if (IS_ENTRY_A4(peer))
+		return -1;
+#endif
+	tr = &ad->tr_ctl.tr_entry[peer->wcid];
+	if (tr->wdev != wdev)
+		return -1;
+	/* An aggregate never acquires a whole-frame authentication exception. */
+	if (RX_BLK_TEST_FLAG(rx, fRX_AMSDU) || RX_BLK_TEST_FLAG(rx, fRX_ARALINK)) {
+		kind = APBR_WIRE_DATA;
+	} else {
+		kind = apbr_parse_wire(data, length,
+				       ethernet ? APBR_ETHERNET : APBR_LLC, &view);
+		if (kind == APBR_WIRE_INVALID)
+			return -1;
+	}
+	if (kind == APBR_WIRE_EAPOL) {
+		if (!mtk_ap_bridge_stamp(RTPKT_TO_OSPKT(rx->pRxPacket),
+					 &rx->ap_bridge_reader, true))
+			return -1;
+		return 1;
+	}
+	if (READ_ONCE(tr->PortSecured) != WPA_802_1X_PORT_SECURED ||
+	    READ_ONCE(peer->PrivacyFilter) == Ndis802_11PrivFilter8021xWEP)
+		return -1;
+	if (!mtk_ap_bridge_stamp(RTPKT_TO_OSPKT(rx->pRxPacket),
+				 &rx->ap_bridge_reader, true))
+		return -1;
+	return 0;
+}
+
+bool mtk_ap_rx_fragment_prepare(RTMP_ADAPTER *ad, MAC_TABLE_ENTRY *peer,
+				RX_BLK *rx, struct wifi_dev *wdev)
+{
+	FRAME_CONTROL *fc = (FRAME_CONTROL *)rx->FC;
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	/* Fragmented authentication never grants an aggregate-wide exception. */
+	if (!peer || peer->wdev != wdev || !IS_ENTRY_CLIENT(peer) ||
+	    peer->Sst != SST_ASSOC || !VALID_UCAST_ENTRY_WCID(ad, peer->wcid) ||
+	    ad->tr_ctl.tr_entry[peer->wcid].wdev != wdev ||
+	    READ_ONCE(ad->tr_ctl.tr_entry[peer->wcid].PortSecured) !=
+		WPA_802_1X_PORT_SECURED ||
+	    READ_ONCE(peer->PrivacyFilter) == Ndis802_11PrivFilter8021xWEP)
+		return false;
+	if (!fc || fc->Type != FC_TYPE_DATA || !fc->ToDs || fc->FrDs)
+		return false;
+#ifdef A4_CONN
+	if (IS_ENTRY_A4(peer))
+		return false;
+#endif
+	return mtk_ap_bridge_stamp(RTPKT_TO_OSPKT(rx->pRxPacket),
+				  &rx->ap_bridge_reader, true);
+}
+
+/* 0: genuine management/control, 1: payload data, 2: NULL data. */
+static int mtk_ap_raw_class(RTMP_ADAPTER *ad, PNDIS_PACKET pkt, bool force)
+{
+	struct sk_buff *skb = RTPKT_TO_OSPKT(pkt);
+	unsigned int off, fc;
+	if (!force && !RTMP_GET_PACKET_MGMT_PKT(pkt))
+		return 1;
+	off = hc_get_chip_cap(ad->hdev_ctrl)->tx_hw_hdr_len;
+	if (!pskb_may_pull(skb, off + 2))
+		return -1;
+	fc = skb->data[off] | ((unsigned int)skb->data[off + 1] << 8);
+	if ((fc & 0xc) == 4)
+		return pskb_may_pull(skb, off +
+			(((fc & 0xf0) == 0xc0 || (fc & 0xf0) == 0xd0) ? 10 : 16)) ? 0 : -1;
+	if (!pskb_may_pull(skb, off + 24))
+		return -1;
+	if ((fc & 0xc) == 8)
+		return (fc & 0x40) ? 2 : 1;
+	if ((fc & 0xc) == 0)
+		return 0;
+	return -1;
+}
+
+bool mtk_ap_tx_begin(RTMP_ADAPTER *ad, struct wifi_dev *wdev, PNDIS_PACKET pkt,
+		     struct mtk_ap_bridge_reader *reader, bool raw)
+{
+	int type = raw ? mtk_ap_raw_class(ad, pkt, true) : 1;
+	memset(reader, 0, sizeof(*reader));
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	if (type < 0)
+		return false;
+	if (!type)
+		return true;
+	if (!mtk_ap_bridge_enter(wdev->ap_bridge_gate, reader))
+		return false;
+	if (!mtk_ap_role_supported(ad, wdev)) {
+		mtk_ap_bridge_exit(reader);
+		return false;
+	}
+	if (raw) {
+		if (type == 2 ? mtk_ap_bridge_stamp(RTPKT_TO_OSPKT(pkt), reader, false) :
+		    mtk_ap_bridge_tx_domain_validate(RTPKT_TO_OSPKT(pkt), reader))
+			return true;
+	} else if (mtk_ap_bridge_tx_domain_stamp(RTPKT_TO_OSPKT(pkt), reader)) {
+		return true;
+	}
+	mtk_ap_bridge_exit(reader);
+	return false;
+}
+
+bool mtk_ap_tx_valid(RTMP_ADAPTER *ad, struct wifi_dev *wdev, PNDIS_PACKET pkt,
+		     const struct mtk_ap_bridge_reader *reader)
+{
+	struct sk_buff *skb = RTPKT_TO_OSPKT(pkt);
+	struct apbr_wire_view view;
+	const UCHAR *da;
+	MAC_TABLE_ENTRY *peer;
+	STA_TR_ENTRY *tr;
+	UINT16 wcid;
+	bool eap = false;
+	bool ordinary, radius_allowed = true;
+	int raw_type;
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	if (RTMP_GET_PACKET_WDEV(pkt) != wdev->wdev_idx)
+		return false;
+	raw_type = mtk_ap_raw_class(ad, pkt, false);
+	if (!raw_type)
+		return true;
+	if (raw_type < 0 || !(raw_type == 2 ?
+	    mtk_ap_bridge_validate(skb, reader, false) :
+	    mtk_ap_bridge_tx_domain_validate(skb, reader)))
+		return false;
+	if (!pskb_may_pull(skb, LENGTH_802_3))
+		return false;
+	da = skb->data;
+	if (RTMP_GET_PACKET_MGMT_PKT(pkt)) {
+		unsigned int off = hc_get_chip_cap(ad->hdev_ctrl)->tx_hw_hdr_len;
+		unsigned int fc;
+		if (!pskb_may_pull(skb, off + 24))
+			return false;
+		fc = skb->data[off] | ((unsigned int)skb->data[off + 1] << 8);
+		if ((fc & 0xc) != 8)
+			return true;
+		da = skb->data + off + 4;
+		eap = apbr_parse_wire(skb->data + off, skb->len - off,
+				       APBR_IEEE80211, &view) == APBR_WIRE_EAPOL;
+	} else {
+		enum apbr_wire_kind kind = apbr_parse_wire(skb->data, skb_headlen(skb),
+						      APBR_ETHERNET, &view);
+		if (kind == APBR_WIRE_INVALID)
+			return false;
+		eap = kind == APBR_WIRE_EAPOL;
+	}
+	wcid = RTMP_GET_PACKET_WCID(pkt);
+	if (!IS_WCID_VALID(ad, wcid) || !IS_TR_WCID_VALID(ad, wcid))
+		return false;
+	tr = &ad->tr_ctl.tr_entry[wcid];
+	peer = &ad->MacTab.Content[wcid];
+	ordinary = IS_ENTRY_CLIENT(peer);
+#ifdef A4_CONN
+	if (IS_ENTRY_A4(peer))
+		ordinary = false;
+#endif
+#ifdef RADIUS_MAC_AUTH_SUPPORT
+	if (wdev->radius_mac_auth_enable && !ad->CommonCfg.bRadiusMacAuthDisabled &&
+	    !peer->bAllowTraffic)
+		radius_allowed = false;
+#endif
+	return apbr_tx_binding_matches(da, peer->Addr, wdev, peer->wdev, tr->wdev,
+		wcid, wdev->tr_tb_idx, peer->sta_rec_valid, peer->Sst == SST_ASSOC,
+		ordinary, READ_ONCE(tr->PortSecured) == WPA_802_1X_PORT_SECURED,
+		READ_ONCE(wdev->PortSecured) == WPA_802_1X_PORT_SECURED,
+		raw_type == 2 || eap, radius_allowed);
+}
+
+bool mtk_ap_tx_queued_valid(RTMP_ADAPTER *ad, struct wifi_dev *wdev,
+			    PNDIS_PACKET pkt)
+{
+	struct mtk_ap_bridge_reader reader = { 0 };
+	bool valid;
+	if (!mtk_ap_plain_ap(wdev))
+		return true;
+	if (!mtk_ap_tx_enter_queued(ad, wdev, pkt, &reader))
+		return false;
+	valid = mtk_ap_tx_valid(ad, wdev, pkt, &reader);
+	mtk_ap_bridge_exit(&reader);
+	return valid;
+}
+
+bool mtk_ap_tx_enter_queued(RTMP_ADAPTER *ad, struct wifi_dev *wdev,
+			   PNDIS_PACKET pkt, struct mtk_ap_bridge_reader *reader)
+{
+	memset(reader, 0, sizeof(*reader));
+	if (!mtk_ap_plain_ap(wdev) || mtk_ap_raw_class(ad, pkt, false) == 0)
+		return true;
+	if (!mtk_ap_bridge_enter(wdev->ap_bridge_gate, reader))
+		return false;
+	if (!mtk_ap_role_supported(ad, wdev)) {
+		mtk_ap_bridge_exit(reader);
+		return false;
+	}
+	return true;
+}
