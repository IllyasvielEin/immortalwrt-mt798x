--- a/mt_wifi/embedded/common/cmm_data.c
+++ b/mt_wifi/embedded/common/cmm_data.c
@@ -25,6 +25,273 @@
 
 
 #include "rt_config.h"
+
+#include <linux/etherdevice.h>
+#include <linux/moduleparam.h>
+#include <linux/ratelimit.h>
+#include "roam_diag_parse.h"
+
+/* Diagnostic only. No station state, forwarding decision or packet is changed. */
+static DEFINE_SPINLOCK(mt_roam_diag_lock);
+static unsigned char mt_roam_diag_macs[2][6];
+static unsigned int mt_roam_diag_count;
+static unsigned short roam_diag_port = 3773;
+/* Shared budgets count log records, not packets or actual deletions.
+ * One packet can emit three stages; one deletion can emit several events.
+ */
+static DEFINE_RATELIMIT_STATE(mt_roam_diag_packet_rate, HZ, 64);
+static DEFINE_RATELIMIT_STATE(mt_roam_diag_delete_rate, HZ, 16);
+static atomic64_t mt_roam_diag_seen[MT_ROAM_DIAG_STAGES] = {
+	ATOMIC64_INIT(0), ATOMIC64_INIT(0), ATOMIC64_INIT(0)
+};
+static atomic64_t mt_roam_diag_packet_logs = ATOMIC64_INIT(0);
+static atomic64_t mt_roam_diag_packet_drops = ATOMIC64_INIT(0);
+static atomic64_t mt_roam_diag_delete_seen = ATOMIC64_INIT(0);
+static atomic64_t mt_roam_diag_delete_logs = ATOMIC64_INIT(0);
+static atomic64_t mt_roam_diag_delete_drops = ATOMIC64_INIT(0);
+
+static int mt_roam_diag_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned char macs[2][6] __aligned(2) = {{0}};
+	unsigned int count = 0, i;
+	unsigned long irq;
+	char text[40];
+	size_t len = strnlen(value, sizeof(text));
+
+	(void)kp;
+	if (len >= sizeof(text))
+		return -EINVAL;
+	memcpy(text, value, len + 1);
+	while (len && (text[len - 1] == '\n' || text[len - 1] == '\r'))
+		text[--len] = 0;
+	if (!strcmp(text, "off")) {
+		count = 0;
+	} else if (len == 17 || (len == 35 && text[17] == ',')) {
+		count = len == 17 ? 1 : 2;
+		for (i = 0; i < count; i++) {
+			const char *p = text + i * 18;
+
+			if (!mac_pton(p, macs[i]) || !is_valid_ether_addr(macs[i]))
+				return -EINVAL;
+		}
+	} else {
+		return -EINVAL;
+	}
+	spin_lock_irqsave(&mt_roam_diag_lock, irq);
+	memcpy(mt_roam_diag_macs, macs, sizeof(macs));
+	WRITE_ONCE(mt_roam_diag_count, count);
+	spin_unlock_irqrestore(&mt_roam_diag_lock, irq);
+	return 0;
+}
+
+static int mt_roam_diag_get(char *buffer, const struct kernel_param *kp)
+{
+	unsigned char macs[2][6];
+	unsigned long irq;
+	unsigned int count;
+
+	(void)kp;
+	spin_lock_irqsave(&mt_roam_diag_lock, irq);
+	count = mt_roam_diag_count;
+	memcpy(macs, mt_roam_diag_macs, sizeof(macs));
+	spin_unlock_irqrestore(&mt_roam_diag_lock, irq);
+	if (!count)
+		return scnprintf(buffer, PAGE_SIZE, "off\n");
+	if (count == 1)
+		return scnprintf(buffer, PAGE_SIZE, "%pM\n", macs[0]);
+	return scnprintf(buffer, PAGE_SIZE, "%pM,%pM\n", macs[0], macs[1]);
+}
+
+static const struct kernel_param_ops mt_roam_diag_ops = {
+	.set = mt_roam_diag_set,
+	.get = mt_roam_diag_get,
+};
+module_param_cb(roam_diag_mac, &mt_roam_diag_ops, NULL, 0600);
+MODULE_PARM_DESC(roam_diag_mac, "off (default), or one/two comma-separated unicast MACs");
+module_param_named(roam_diag_port, roam_diag_port, ushort, 0600);
+MODULE_PARM_DESC(roam_diag_port, "Target TCP port for SYN/RST diagnostics (default 3773)");
+
+static int mt_roam_diag_match(const unsigned char *mac)
+{
+	unsigned int i, count;
+	unsigned long irq;
+	int matched = 0;
+
+	if (!mac || !READ_ONCE(mt_roam_diag_count))
+		return 0;
+	spin_lock_irqsave(&mt_roam_diag_lock, irq);
+	count = mt_roam_diag_count;
+	for (i = 0; i < count; i++)
+		if (!memcmp(mac, mt_roam_diag_macs[i], 6)) {
+			matched = 1;
+			break;
+		}
+	spin_unlock_irqrestore(&mt_roam_diag_lock, irq);
+	return matched;
+}
+
+static int mt_roam_diag_read(void *context, unsigned int offset,
+			    void *buffer, unsigned int length)
+{
+	return skb_copy_bits(context, offset, buffer, length);
+}
+
+
+/* Counters count matching records since module load, not unique packets/STAs.
+ * Reads across counters are not an atomic snapshot. Suppression is not path absence.
+ */
+static int mt_roam_diag_stats_get(char *buffer, const struct kernel_param *kp)
+{
+	(void)kp;
+	return scnprintf(buffer, PAGE_SIZE,
+		"rx_before=%lld fwd_result=%lld rx_after=%lld "
+		"packet_logs=%lld packet_suppressed=%lld "
+		"delete_seen=%lld delete_logs=%lld delete_suppressed=%lld\n",
+		(long long)atomic64_read(&mt_roam_diag_seen[MT_ROAM_DIAG_RX_BEFORE]),
+		(long long)atomic64_read(&mt_roam_diag_seen[MT_ROAM_DIAG_FORWARD]),
+		(long long)atomic64_read(&mt_roam_diag_seen[MT_ROAM_DIAG_RX_AFTER]),
+		(long long)atomic64_read(&mt_roam_diag_packet_logs),
+		(long long)atomic64_read(&mt_roam_diag_packet_drops),
+		(long long)atomic64_read(&mt_roam_diag_delete_seen),
+		(long long)atomic64_read(&mt_roam_diag_delete_logs),
+		(long long)atomic64_read(&mt_roam_diag_delete_drops));
+}
+static int mt_roam_diag_stats_set(const char *value, const struct kernel_param *kp)
+{
+	(void)value;
+	(void)kp;
+	return -EPERM;
+}
+static const struct kernel_param_ops mt_roam_diag_stats_ops = {
+	.set = mt_roam_diag_stats_set,
+	.get = mt_roam_diag_stats_get,
+};
+module_param_cb(roam_diag_stats, &mt_roam_diag_stats_ops, NULL, 0400);
+MODULE_PARM_DESC(roam_diag_stats, "Read-only matched and suppressed diagnostic counters");
+
+VOID mt_roam_diag_init(struct mt_roam_diag_ctx *ctx,
+	struct wifi_dev *wdev, PNDIS_PACKET packet)
+{
+	struct sk_buff *skb = RTPKT_TO_OSPKT(packet);
+	struct mt_roam_diag_frame frame;
+	struct net_device *ndev;
+	unsigned char eth[14];
+
+	ctx->active = 0;
+	if (!READ_ONCE(mt_roam_diag_count) || !skb || !wdev ||
+	    skb_copy_bits(skb, 0, eth, sizeof(eth)) ||
+	    (!mt_roam_diag_match(eth) && !mt_roam_diag_match(eth + 6)) ||
+	    !mt_roam_diag_decode(skb, skb->len, mt_roam_diag_read,
+				 READ_ONCE(roam_diag_port), &frame))
+		return;
+	*ctx = (struct mt_roam_diag_ctx) {
+		.active = 1, .frame = frame, .path = "not-looked-up",
+		.in_wdev = wdev->wdev_idx, .iif = skb->skb_iif,
+		.lookup_hit = -1, .lookup_slot = -1, .lookup_sst = -1,
+		.dst_wdev_slot = -1, .same_wdev = -1,
+		.tx_wcid = -1, .tx_wdev = -1, .submit_status = -1,
+	};
+	memcpy(ctx->bssid, wdev->bssid, sizeof(ctx->bssid));
+	ndev = READ_ONCE(wdev->if_dev);
+	if (ndev)
+		strscpy(ctx->ifname, ndev->name, sizeof(ctx->ifname));
+}
+
+/* Compare owned table slots; never dereference a destination wdev/entry. */
+INT mt_roam_diag_wdev_slot(RTMP_ADAPTER *ad, const struct wifi_dev *wdev)
+{
+	unsigned int i;
+
+	if (!wdev)
+		return -1;
+	for (i = 0; i < ARRAY_SIZE(ad->wdev_list); i++)
+		if (READ_ONCE(ad->wdev_list[i]) == wdev)
+			return i;
+	return -1;
+}
+
+INT mt_roam_diag_entry_slot(RTMP_ADAPTER *ad, const MAC_TABLE_ENTRY *entry)
+{
+	unsigned int i;
+
+	if (!entry)
+		return -1;
+	for (i = 0; i < ARRAY_SIZE(ad->MacTab.Content); i++)
+		if (&ad->MacTab.Content[i] == entry)
+			return i;
+	return -1;
+}
+
+VOID mt_roam_diag_packet(const struct mt_roam_diag_ctx *ctx,
+	enum mt_roam_diag_stage stage, int to_os, int to_air)
+{
+	static const char * const names[] = {
+		"rx-before-fwd", "fwd-result", "rx-after-fwd"
+	};
+	const struct mt_roam_diag_frame *f;
+
+	if (!ctx->active || !READ_ONCE(mt_roam_diag_count) ||
+	    stage < 0 || stage >= MT_ROAM_DIAG_STAGES)
+		return;
+	atomic64_inc(&mt_roam_diag_seen[stage]);
+	if (!__ratelimit(&mt_roam_diag_packet_rate)) {
+		atomic64_inc(&mt_roam_diag_packet_drops);
+		return;
+	}
+	atomic64_inc(&mt_roam_diag_packet_logs);
+	f = &ctx->frame;
+	/* Only captured values: no post-decision entry/wdev/skb reads here. */
+	pr_info("ROAMDIAG stage=%s path=%s if=%s in_wdev=%d bssid=%pM iif=%d "
+		"src=%pM dst=%pM ip=%pI4:%u>%pI4:%u flags=%02x seq=%u ack=%u "
+		"lookup_hit=%d lookup_slot=%d sst_test=%d dst_wdev_slot=%d "
+		"same_wdev=%d source_blocked=%d tx_wcid=%d tx_wdev=%d "
+		"to_os=%d to_air=%d submitted=%d submit_rc=%d\n",
+		names[stage], ctx->path, ctx->ifname, ctx->in_wdev,
+		ctx->bssid, ctx->iif, f->src, f->dst,
+		f->sip, (unsigned int)f->sport, f->dip, (unsigned int)f->dport,
+		(unsigned int)f->flags, f->seq, f->ack,
+		ctx->lookup_hit, ctx->lookup_slot, ctx->lookup_sst,
+		ctx->dst_wdev_slot, ctx->same_wdev, ctx->source_blocked,
+		ctx->tx_wcid, ctx->tx_wdev, to_os, to_air,
+		ctx->submitted, ctx->submit_status);
+}
+
+VOID mt_roam_diag_delete(RTMP_ADAPTER *ad, MAC_TABLE_ENTRY *entry,
+	const UCHAR *requested, unsigned int requested_wcid,
+	const char *stage, int reason, const void *caller)
+{
+	unsigned char current[6], requested_copy[6];
+	struct wifi_dev *wdev;
+	unsigned int twt = 0;
+
+	if (!READ_ONCE(mt_roam_diag_count) || !entry)
+		return;
+	memcpy(current, entry->Addr, sizeof(current));
+	memcpy(requested_copy, requested ? requested : current, sizeof(requested_copy));
+	if (!mt_roam_diag_match(current) && !mt_roam_diag_match(requested_copy))
+		return;
+	atomic64_inc(&mt_roam_diag_delete_seen);
+	if (!__ratelimit(&mt_roam_diag_delete_rate)) {
+		atomic64_inc(&mt_roam_diag_delete_drops);
+		return;
+	}
+	atomic64_inc(&mt_roam_diag_delete_logs);
+	wdev = READ_ONCE(entry->wdev);
+#if defined(DOT11_HE_AX) && defined(WIFI_TWT_SUPPORT)
+	twt = READ_ONCE(entry->twt_flow_id_bitmap);
+#endif
+	/* These counters are observations, not an atomic station-identity claim. */
+	pr_info("ROAMDIAG stage=%s mac_obs=%pM requested=%pM requested_wcid=%u "
+		"entry_wcid_obs=%u wdev_slot_obs=%d sst_obs=%d idle_obs=%lu "
+		"timeout_obs=%u ps_obs=%u twt_obs=%u tx_fail_obs=%u "
+		"reason=%d caller=%pS\n",
+		stage, current, requested_copy, requested_wcid,
+		(unsigned int)READ_ONCE(entry->wcid), mt_roam_diag_wdev_slot(ad, wdev),
+		(int)READ_ONCE(entry->Sst), (unsigned long)READ_ONCE(entry->NoDataIdleCount),
+		(unsigned int)READ_ONCE(entry->StaIdleTimeout),
+		(unsigned int)READ_ONCE(entry->PsMode), twt,
+		(unsigned int)READ_ONCE(entry->ContinueTxFailCnt), reason, caller);
+}
 #ifdef TXRX_STAT_SUPPORT
 #include "hdev/hdev_basic.h"
 #endif
@@ -3518,6 +3785,7 @@
 	struct wifi_dev *wdev,
 	UCHAR op_mode)
 {
+	struct mt_roam_diag_ctx diag;
 	BOOLEAN to_os = FALSE;
 	struct wifi_dev_ops *ops = NULL;
 	struct tr_counter *tr_cnt = &pAd->tr_ctl.tr_cnt;
@@ -3605,8 +3873,11 @@
 	}
 #endif /*VLAN_SUPPORT*/
 
+	mt_roam_diag_init(&diag, wdev, pPacket);
+	mt_roam_diag_packet(&diag, MT_ROAM_DIAG_RX_BEFORE, -1, -1);
 	if (ops->rx_pkt_foward)
 		to_os = ops->rx_pkt_foward(pAd, wdev, pPacket);
+	mt_roam_diag_packet(&diag, MT_ROAM_DIAG_RX_AFTER, to_os, -1);
 
 	if (to_os == TRUE) {
